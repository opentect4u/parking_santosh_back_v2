<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
  window.addEventListener('load', function () {
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
    script.onload = function () {
      $('#custId').select2({
        placeholder: "Select Location Name",
        allowClear: true,
        width: '100%'
      });
    };
    document.body.appendChild(script);
  });
</script>
<script>
    document.getElementById("footerYear").textContent = new Date().getFullYear();

    $(document).ready(function() {
        let table;

        $('#custId').on('change', function() {
            if(table) table.clear().draw();
            $('#resultDiv').hide();
        });

        $('#btnSubmit').on('click', function() {
            var frm_dt = $('#frm_dt').val();
            var to_dt = $('#to_dt').val();
            var custId = $('#custId').val();
            var custName = $("#custId option:selected").text();

            if(frm_dt && to_dt && custId) {
                if(table) {
                    table.destroy();
                    $('#shift-wise-datatable tbody').empty();
                }

                $('#resultDiv').show();
                $('#searchCred').html(`<b>Shift Wise Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);

                table = $('#shift-wise-datatable').DataTable({
                    processing: true,
                    serverSide: true,
                    searching: false,
                    lengthChange: true,
                    pageLength: 50,
                    ajax: {
                        url: "/report/get_shift_wise_repo_new",
                        type: "POST",
                        data: function(d) {
                            d.frm_dt = $('#frm_dt').val();
                            d.to_dt = $('#to_dt').val();
                            d.custId = $('#custId').val();
                        },
                        beforeSend: function () {
                            $(".preloader").fadeIn();
                        },
                        complete: function () {
                            $(".preloader").fadeOut();
                        }
                    },
                    drawCallback: function(settings) {
                        if (settings.json && settings.json.grandTotals) {
                            let gt = settings.json.grandTotals;
                            $('#tot_base').text(parseFloat(gt.base_amt || 0).toFixed(2));
                            $('#tot_advance').text(parseFloat(gt.advance_amt || 0).toFixed(2));
                            $('#tot_cgst').text(parseFloat(gt.cgst || 0).toFixed(2));
                            $('#tot_sgst').text(parseFloat(gt.sgst || 0).toFixed(2));
                            $('#tot_igst').text(parseFloat(gt.igst || 0).toFixed(2));
                            $('#tot_paid').text(parseFloat(gt.paid_amt || 0).toFixed(2));
                            
                            let grand_net = parseFloat(gt.base_amt || 0) + parseFloat(gt.advance_amt || 0) + parseFloat(gt.cgst || 0) + parseFloat(gt.sgst || 0) + parseFloat(gt.igst || 0);
                            $('#tot_net').text(grand_net.toFixed(2));
                        }
                        
                        let pageTotalCnt = 0;
                        let api = this.api();
                        api.rows({ page: 'current' }).every(function () {
                            let data = this.data();
                            pageTotalCnt += parseInt(data.tot_vehi || 0);
                        });
                        $('#tot_cnt').text(pageTotalCnt);
                    },
                    columns: [
                        {
                            data: null,
                            render: function (data, type, row, meta) {
                                return meta.row + meta.settings._iDisplayStart + 1;
                            }
                        },
                        { data: "mc_srl_no_out" },
                        { data: "vehicleType" },
                        { data: "tot_vehi" },
                        { data: "opratorName" },
                        { data: "shift_name" },
                        { data: "base_amt", render: function(data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "advance_amt", render: function(data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "cgst", render: function(data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "sgst", render: function(data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "igst", render: function(data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "paid_amt", render: function(data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: null, render: function(data, type, row) { 
                            return (parseFloat(row.base_amt || 0) + parseFloat(row.advance_amt || 0) + parseFloat(row.cgst || 0) + parseFloat(row.sgst || 0) + parseFloat(row.igst || 0)).toFixed(2);
                        } }
                    ]
                });
            }
        });
    });

    function downloadExcel() {
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
        var custName = $("#custId option:selected").text();

        if(!frm_dt || !to_dt || !custId) {
            alert("Please select filters and search first.");
            return;
        }

        $(".preloader").fadeIn();
        $.ajax({
            url: "/report/get_shift_wise_repo_excel",
            type: "POST",
            data: { frm_dt: frm_dt, to_dt: to_dt, custId: custId },
            success: function(response) {
                $(".preloader").fadeOut();
                if(response.suc > 0 && response.data.length > 0) {
                    var excelData = [];
                    var tot_cnt = 0, tot_base = 0, tot_advance = 0, tot_cgst = 0, tot_sgst = 0, tot_igst = 0, tot_paid = 0, tot_net = 0;

                    for(var i=0; i<response.data.length; i++) {
                        var row = response.data[i];
                        tot_cnt += parseInt(row.tot_vehi || 0);
                        tot_base += parseFloat(row.base_amt || 0);
                        tot_advance += parseFloat(row.advance_amt || 0);
                        tot_cgst += parseFloat(row.cgst || 0);
                        tot_sgst += parseFloat(row.sgst || 0);
                        tot_igst += parseFloat(row.igst || 0);
                        tot_paid += parseFloat(row.paid_amt || 0);
                        
                        var row_net = parseFloat(row.base_amt || 0) + parseFloat(row.advance_amt || 0) + parseFloat(row.cgst || 0) + parseFloat(row.sgst || 0) + parseFloat(row.igst || 0);
                        tot_net += row_net;

                        excelData.push({
                            "Sl No": i + 1,
                            "Machine Sl. No.": row.mc_srl_no_out,
                            "Vehicle Type": row.vehicleType,
                            "Count": row.tot_vehi,
                            "Operator Name": row.opratorName,
                            "Shift Name": row.shift_name,
                            "Base Amount": parseFloat(row.base_amt || 0).toFixed(2),
                            "Advance Amount": parseFloat(row.advance_amt || 0).toFixed(2),
                            "CGST": parseFloat(row.cgst || 0).toFixed(2),
                            "SGST": parseFloat(row.sgst || 0).toFixed(2),
                            "IGST": parseFloat(row.igst || 0).toFixed(2),
                            "Paid Amount": parseFloat(row.paid_amt || 0).toFixed(2),
                            "Net Amount": row_net.toFixed(2)
                        });
                    }

                    excelData.push({
                        "Sl No": "",
                        "Machine Sl. No.": "Grand Total",
                        "Vehicle Type": "",
                        "Count": tot_cnt,
                        "Operator Name": "",
                        "Shift Name": "",
                        "Base Amount": tot_base.toFixed(2),
                        "Advance Amount": tot_advance.toFixed(2),
                        "CGST": tot_cgst.toFixed(2),
                        "SGST": tot_sgst.toFixed(2),
                        "IGST": tot_igst.toFixed(2),
                        "Paid Amount": tot_paid.toFixed(2),
                        "Net Amount": tot_net.toFixed(2)
                    });

                    var ws = XLSX.utils.json_to_sheet(excelData);
                    var wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, "Shift Wise Report");
                    XLSX.writeFile(wb, "Shift_Wise_Report_" + custName + ".xlsx");
                } else {
                    alert("No data available for Excel export.");
                }
            },
            error: function() {
                $(".preloader").fadeOut();
                alert("Error generating Excel.");
            }
        });
    }

    function printDiv() {
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
        var custName = $("#custId option:selected").text();

        if(!frm_dt || !to_dt || !custId) return;

        $(".preloader").fadeIn();
        $.ajax({
            url: "/report/get_shift_wise_repo_excel",
            type: "POST",
            data: { frm_dt: frm_dt, to_dt: to_dt, custId: custId },
            success: function(response) {
                $(".preloader").fadeOut();
                if(response.suc > 0 && response.data.length > 0) {
                    
                    var tableHtml = `
                    <div style="text-align: center; margin-bottom: 20px;">
                        <h2>Shift Wise Report</h2>
                        <h4>Location: ${custName}</h4>
                        <p>From: ${createDate(frm_dt)} To: ${createDate(to_dt)}</p>
                    </div>
                    <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px;">
                        <thead>
                            <tr>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Sl No</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Machine No</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Vehicle Type</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Count</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Operator</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Shift</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Base Amt</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Adv Amt</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">CGST</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">SGST</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">IGST</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Paid Amt</th>
                                <th style="border: 1px solid #000; padding: 8px; background-color: #e2e8f0;">Net Amt</th>
                            </tr>
                        </thead>
                        <tbody>
                    `;

                    var tot_cnt = 0, tot_base = 0, tot_advance = 0, tot_cgst = 0, tot_sgst = 0, tot_igst = 0, tot_paid = 0, tot_net = 0;

                    for(var i=0; i<response.data.length; i++) {
                        var row = response.data[i];
                        tot_cnt += parseInt(row.tot_vehi || 0);
                        tot_base += parseFloat(row.base_amt || 0);
                        tot_advance += parseFloat(row.advance_amt || 0);
                        tot_cgst += parseFloat(row.cgst || 0);
                        tot_sgst += parseFloat(row.sgst || 0);
                        tot_igst += parseFloat(row.igst || 0);
                        tot_paid += parseFloat(row.paid_amt || 0);
                        
                        var row_net = parseFloat(row.base_amt || 0) + parseFloat(row.advance_amt || 0) + parseFloat(row.cgst || 0) + parseFloat(row.sgst || 0) + parseFloat(row.igst || 0);
                        tot_net += row_net;

                        tableHtml += `
                        <tr>
                            <td style="border: 1px solid #000; padding: 6px; text-align: center;">${i+1}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: center;">${row.mc_srl_no_out}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: center;">${row.vehicleType}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: center;">${row.tot_vehi}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: center;">${row.opratorName}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: center;">${row.shift_name}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${parseFloat(row.base_amt || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${parseFloat(row.advance_amt || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${parseFloat(row.cgst || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${parseFloat(row.sgst || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${parseFloat(row.igst || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${parseFloat(row.paid_amt || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${row_net.toFixed(2)}</td>
                        </tr>
                        `;
                    }

                    tableHtml += `
                        <tr style="background-color: #f8f9fa; font-weight: bold;">
                            <td colspan="3" style="border: 1px solid #000; padding: 6px; text-align: right;">Grand Total:</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: center;">${tot_cnt}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;" colspan="2"></td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_base.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_advance.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_cgst.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_sgst.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_igst.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_paid.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_net.toFixed(2)}</td>
                        </tr>
                        </tbody>
                    </table>
                    `;

                    var WindowObject = window.open('', 'Print-Window');
                    WindowObject.document.open();
                    WindowObject.document.writeln('<!DOCTYPE html><html><head><title>Shift Wise Report</title></head><body>');
                    WindowObject.document.writeln(tableHtml);
                    WindowObject.document.writeln('<script>window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 500); }<\/script>');
                    WindowObject.document.writeln('</body></html>');
                    WindowObject.document.close();

                } else {
                    alert("No data available to print.");
                }
            },
            error: function() {
                $(".preloader").fadeOut();
                alert("Error fetching data for print.");
            }
        });
    }

    function createDate(dateString) {
        var date = new Date(dateString);
        var day = ("0" + date.getDate()).slice(-2);
        var month = ("0" + (date.getMonth() + 1)).slice(-2);
        var year = date.getFullYear();
        var hours = ("0" + date.getHours()).slice(-2);
        var minutes = ("0" + date.getMinutes()).slice(-2);
        var seconds = ("0" + date.getSeconds()).slice(-2);
        return day + "/" + month + "/" + year + " " + hours + ":" + minutes + ":" + seconds;
    }
</script>
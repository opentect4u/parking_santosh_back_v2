<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
    window.addEventListener('load', function () {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
        script.onload = function () {
            $('#custId, #pay_mode, #operator_id').select2({
                allowClear: false,
                width: '100%'
            });
        };
        document.body.appendChild(script);
    });
</script>

<script>
    document.getElementById("footerYear").textContent = new Date().getFullYear();

    $(document).ready(function () {
        let table;

        // Dynamically load operators when customer is selected
        $('#custId').on('change', function () {
            var custId = $(this).val();
            if (custId) {
                $.ajax({
                    method: "POST",
                    url: "/report/get_operators_by_location",
                    data: JSON.stringify({ custId }),
                    contentType: "application/json",
                    dataType: "json",
                    beforeSend: function () {
                        $("#operator_id").html('<option value="">Loading...</option>');
                    },
                    success: function (res) {
//                       res.msg.forEach(item => {
//     console.log(item.operator_id);
//     console.log(item.operator_name);
// });
// console.log(JSON.stringify(res.msg, null, 2));

//                         alert(res.msg);
                        if (res.msg && res.suc > 0 ) {
                            // let options = '<option value="">Select Operator Name</option>';
                            // options += '<option value="A" selected>All Operators</option>';
                            // res.msg.msg.forEach(op => {
                            //     options += `<option value="${op.operator_id}">${op.operator_name}</option>`;
                            // });
                            // $("#operator_id").html(options).val("A").trigger('change');

                        let options = '<option value="">Select Operator Name</option>';
                                options += '<option value="A" selected>All Operators</option>';

                                res.msg.forEach(op => {
                                    options += `<option value="${op.operator_id}">${op.operator_name}</option>`;
                                });

                                $("#operator_id").html(options).val("A").trigger("change");
                        } else {
                            $("#operator_id").html('<option value="">No Operator Found</option>').trigger('change');
                        }
                    },
                    error: function () {
                        $("#operator_id").html('<option value="">Error loading operators</option>').trigger('change');
                    }
                });
            } else {
                $("#operator_id").html('<option value="">Select Operator Name</option>').trigger('change');
            }
        });

        // Initialize DataTable
        function fetchDatatable() {
            var frm_dt = $('#frm_dt').val();
            var to_dt = $('#to_dt').val();
            var custId = $('#custId').val();
            var pay_mode = $('#pay_mode').val();
            var operator_id = $('#operator_id').val();
            var custName = $("#custId option:selected").text();

            if (frm_dt && to_dt && custId && pay_mode && operator_id) {
                if (table) {
                    table.destroy();
                    $('#summary-datatable tbody').empty();
                }

                $('#resultDiv').show();
                $('#vehicleSearchSection').show();
                $('#searchCred').html(`<b>Summary Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);

                table = $('#summary-datatable').DataTable({
                    processing: true,
                    serverSide: true,
                    searching: false,
                    lengthChange: true,
                    pageLength: 50,
                    ajax: {
                        url: "/report/get_details_report_new",
                        type: "POST",
                        data: function (d) {
                            d.frm_dt = $('#frm_dt').val();
                            d.to_dt = $('#to_dt').val();
                            d.custId = $('#custId').val();
                            d.pay_mode = $('#pay_mode').val();
                            d.operator_id = $('#operator_id').val();
                            d.vehicle_no = $('#vehicleSearch').val();
                        },
                        beforeSend: function () {
                            $(".preloader").fadeIn();
                        },
                        complete: function () {
                            $(".preloader").fadeOut();
                        }
                    },
                    drawCallback: function (settings) {
                        if (settings.json && settings.json.grandTotals) {
                            let gt = settings.json.grandTotals;
                            $('#tot_base').text(parseFloat(gt.base_amt || 0).toFixed(2));
                            $('#tot_advance').text(parseFloat(gt.advance_amt || 0).toFixed(2));
                            $('#tot_cgst').text(parseFloat(gt.cgst || 0).toFixed(2));
                            $('#tot_sgst').text(parseFloat(gt.sgst || 0).toFixed(2));
                            $('#tot_igst').text(parseFloat(gt.igst || 0).toFixed(2));
                            $('#tot_paid').text(parseFloat(gt.paid_amt || 0).toFixed(2));

                            let grand_net = parseFloat(gt.base_amt || 0) + parseFloat(gt.advance_amt || 0) + parseFloat(gt.cgst || 0) + parseFloat(gt.sgst || 0) + parseFloat(gt.igst || 0);
                            $('#tot_net').text(grand_net.toFixed(2));

                            if (pay_mode === 'A') {
                                $('#upiRow').show();
                                $('#cashRow').show();
                                $('#tot_upi').text(parseFloat(gt.tot_upi || 0).toFixed(2));
                                $('#tot_cash').text(parseFloat(gt.tot_cash || 0).toFixed(2));
                            } else {
                                $('#upiRow').hide();
                                $('#cashRow').hide();
                            }
                        }
                    },
                    columns: [
                        {
                            data: null,
                            render: function (data, type, row, meta) {
                                return meta.row + meta.settings._iDisplayStart + 1;
                            }
                        },
                        { data: "receipt_no", render: function (data) { return data ? String(data).slice(-5) : ''; } },
                        { data: "date_time_in" },
                        { data: "device_id" },
                        { data: "vehicle_name" },
                        { data: "vehicle_no" },
                        { data: "date_time_out" },
                        { data: "device_id_out" },
                        { data: "base_amt", render: function (data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "advance_amt", render: function (data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "cgst", render: function (data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "sgst", render: function (data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "igst", render: function (data) { return parseFloat(data || 0).toFixed(2); } },
                        { data: "paid_amt", render: function (data) { return parseFloat(data || 0).toFixed(2); } },
                        {
                            data: null, render: function (data, type, row) {
                                return (parseFloat(row.base_amt || 0) + parseFloat(row.advance_amt || 0) + parseFloat(row.cgst || 0) + parseFloat(row.sgst || 0) + parseFloat(row.igst || 0)).toFixed(2);
                            }
                        },
                        { data: "pay_mode", render: function (data) { return data === 'U' ? 'UPI' : (data === 'C' ? 'CASH' : ''); } },
                        { data: "operator_name" }
                    ]
                });
            } else {
                alert("Please fill all fields.");
            }
        }

        $('#btnSubmit').on('click', fetchDatatable);

        $('#btnVehicleSearch').on('click', function () {
            if (table) {
                table.ajax.reload();
            }
        });
    });

    function downloadExcel() {
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
        var pay_mode = $('#pay_mode').val();
        var operator_id = $('#operator_id').val();
        var custName = $("#custId option:selected").text();

        if (!frm_dt || !to_dt || !custId || !operator_id) {
            alert("Please select filters and search first.");
            return;
        }

        $(".preloader").fadeIn();
        $.ajax({
            url: "/report/get_details_report_excel",
            type: "POST",
            data: { frm_dt, to_dt, custId, pay_mode, operator_id },
            success: function (response) {
                $(".preloader").fadeOut();
                if (response.suc > 0 && response.data.length > 0) {
                    var excelData = [];
                    var tot_base = 0, tot_advance = 0, tot_cgst = 0, tot_sgst = 0, tot_igst = 0, tot_paid = 0, tot_net = 0;
                    var tot_upi = 0, tot_cash = 0;

                    for (var i = 0; i < response.data.length; i++) {
                        var row = response.data[i];
                        tot_base += parseFloat(row.base_amt || 0);
                        tot_advance += parseFloat(row.advance_amt || 0);
                        tot_cgst += parseFloat(row.cgst || 0);
                        tot_sgst += parseFloat(row.sgst || 0);
                        tot_igst += parseFloat(row.igst || 0);
                        tot_paid += parseFloat(row.paid_amt || 0);

                        var row_net = parseFloat(row.base_amt || 0) + parseFloat(row.advance_amt || 0) + parseFloat(row.cgst || 0) + parseFloat(row.sgst || 0) + parseFloat(row.igst || 0);
                        tot_net += row_net;

                        if (row.pay_mode === 'U') tot_upi += row_net;
                        if (row.pay_mode === 'C') tot_cash += row_net;

                        excelData.push({
                            "Sl No": i + 1,
                            "Receipt No": row.receipt_no ? String(row.receipt_no).slice(-5) : '',
                            "Date Time In": row.date_time_in,
                            "Machine In": row.device_id,
                            "Vehicle Type": row.vehicle_name,
                            "Vehicle No": row.vehicle_no,
                            "Date Time Out": row.date_time_out,
                            "Machine Out": row.device_id_out,
                            "Base Amount": parseFloat(row.base_amt || 0).toFixed(2),
                            "Advance Amount": parseFloat(row.advance_amt || 0).toFixed(2),
                            "CGST": parseFloat(row.cgst || 0).toFixed(2),
                            "SGST": parseFloat(row.sgst || 0).toFixed(2),
                            "IGST": parseFloat(row.igst || 0).toFixed(2),
                            "Paid Amount": parseFloat(row.paid_amt || 0).toFixed(2),
                            "Net Amount": row_net.toFixed(2),
                            "Mode": row.pay_mode === 'U' ? 'UPI' : (row.pay_mode === 'C' ? 'CASH' : ''),
                            "Operator Name": row.operator_name
                        });
                    }

                    excelData.push({
                        "Sl No": "", "Receipt No": "Grand Total", "Date Time In": "", "Machine In": "",
                        "Vehicle Type": "", "Vehicle No": "", "Date Time Out": "", "Machine Out": "",
                        "Base Amount": tot_base.toFixed(2),
                        "Advance Amount": tot_advance.toFixed(2),
                        "CGST": tot_cgst.toFixed(2),
                        "SGST": tot_sgst.toFixed(2),
                        "IGST": tot_igst.toFixed(2),
                        "Paid Amount": tot_paid.toFixed(2),
                        "Net Amount": tot_net.toFixed(2),
                        "Mode": "", "Operator Name": ""
                    });

                    if (pay_mode === 'A') {
                        excelData.push({
                            "Sl No": "", "Receipt No": "Total UPI", "Date Time In": "", "Machine In": "",
                            "Vehicle Type": "", "Vehicle No": "", "Date Time Out": "", "Machine Out": "",
                            "Base Amount": tot_upi.toFixed(2), "Advance Amount": "", "CGST": "", "SGST": "", "IGST": "", "Paid Amount": "", "Net Amount": "", "Mode": "", "Operator Name": ""
                        });
                        excelData.push({
                            "Sl No": "", "Receipt No": "Total Cash", "Date Time In": "", "Machine In": "",
                            "Vehicle Type": "", "Vehicle No": "", "Date Time Out": "", "Machine Out": "",
                            "Base Amount": tot_cash.toFixed(2), "Advance Amount": "", "CGST": "", "SGST": "", "IGST": "", "Paid Amount": "", "Net Amount": "", "Mode": "", "Operator Name": ""
                        });
                    }

                    var ws = XLSX.utils.json_to_sheet(excelData);
                    var wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, "Summary Report");
                    XLSX.writeFile(wb, "Summary_Report_" + custName + ".xlsx");
                } else {
                    alert("No data available for Excel export.");
                }
            },
            error: function () {
                $(".preloader").fadeOut();
                alert("Error generating Excel.");
            }
        });
    }

    function printDiv() {
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
        var pay_mode = $('#pay_mode').val();
        var operator_id = $('#operator_id').val();
        var custName = $("#custId option:selected").text();

        if (!frm_dt || !to_dt || !custId || !operator_id) return;

        $(".preloader").fadeIn();
        $.ajax({
            url: "/report/get_details_report_excel",
            type: "POST",
            data: { frm_dt, to_dt, custId, pay_mode, operator_id },
            success: function (response) {
                $(".preloader").fadeOut();
                if (response.suc > 0 && response.data.length > 0) {

                    var tableHtml = `
                    <div style="text-align: center; margin-bottom: 20px;">
                        <h2>Summary Report</h2>
                        <h4>Location: ${custName}</h4>
                        <p>From: ${createDate(frm_dt)} To: ${createDate(to_dt)}</p>
                    </div>
                    <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; font-size: 12px;">
                        <thead>
                            <tr>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Sl No</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Receipt No</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Date In</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Machine In</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Vehicle Type</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Vehicle No</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Date Out</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Machine Out</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Base Amt</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Adv Amt</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">CGST</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">SGST</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">IGST</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Paid Amt</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Net Amt</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Mode</th>
                                <th style="border: 1px solid #000; padding: 6px; background-color: #e2e8f0;">Operator</th>
                            </tr>
                        </thead>
                        <tbody>
                    `;

                    var tot_base = 0, tot_advance = 0, tot_cgst = 0, tot_sgst = 0, tot_igst = 0, tot_paid = 0, tot_net = 0;
                    var tot_upi = 0, tot_cash = 0;

                    for (var i = 0; i < response.data.length; i++) {
                        var row = response.data[i];
                        tot_base += parseFloat(row.base_amt || 0);
                        tot_advance += parseFloat(row.advance_amt || 0);
                        tot_cgst += parseFloat(row.cgst || 0);
                        tot_sgst += parseFloat(row.sgst || 0);
                        tot_igst += parseFloat(row.igst || 0);
                        tot_paid += parseFloat(row.paid_amt || 0);

                        var row_net = parseFloat(row.base_amt || 0) + parseFloat(row.advance_amt || 0) + parseFloat(row.cgst || 0) + parseFloat(row.sgst || 0) + parseFloat(row.igst || 0);
                        tot_net += row_net;

                        if (row.pay_mode === 'U') tot_upi += row_net;
                        if (row.pay_mode === 'C') tot_cash += row_net;

                        tableHtml += `
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${i + 1}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.receipt_no ? String(row.receipt_no).slice(-5) : ''}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.date_time_in}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.device_id}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.vehicle_name}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.vehicle_no}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.date_time_out}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.device_id_out}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">${parseFloat(row.base_amt || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">${parseFloat(row.advance_amt || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">${parseFloat(row.cgst || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">${parseFloat(row.sgst || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">${parseFloat(row.igst || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">${parseFloat(row.paid_amt || 0).toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">${row_net.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.pay_mode === 'U' ? 'UPI' : (row.pay_mode === 'C' ? 'CASH' : '')}</td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">${row.operator_name}</td>
                        </tr>
                        `;
                    }

                    tableHtml += `
                        <tr style="background-color: #f8f9fa; font-weight: bold;">
                            <td colspan="8" style="border: 1px solid #000; padding: 6px; text-align: right;">Grand Total:</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_base.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_advance.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_cgst.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_sgst.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_igst.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_paid.toFixed(2)}</td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">${tot_net.toFixed(2)}</td>
                            <td colspan="2" style="border: 1px solid #000;"></td>
                        </tr>`;

                    if (pay_mode === 'A') {
                        tableHtml += `
                        <tr style="background-color: #f8f9fa; font-weight: bold;">
                            <td colspan="12" style="border: 1px solid #000; padding: 6px; text-align: right;">Total UPI:</td>
                            <td colspan="5" style="border: 1px solid #000; padding: 6px; text-align: left;">${tot_upi.toFixed(2)}</td>
                        </tr>
                        <tr style="background-color: #f8f9fa; font-weight: bold;">
                            <td colspan="12" style="border: 1px solid #000; padding: 6px; text-align: right;">Total Cash:</td>
                            <td colspan="5" style="border: 1px solid #000; padding: 6px; text-align: left;">${tot_cash.toFixed(2)}</td>
                        </tr>
                        `;
                    }

                    tableHtml += `</tbody></table>`;

                    var WindowObject = window.open('', 'Print-Window');
                    WindowObject.document.open();
                    WindowObject.document.writeln('<!DOCTYPE html><html><head><title>Summary Report</title></head><body>');
                    WindowObject.document.writeln(tableHtml);
                    WindowObject.document.writeln('<script>window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 500); }<\/script>');
                    WindowObject.document.writeln('</body></html>');
                    WindowObject.document.close();

                } else {
                    alert("No data available to print.");
                }
            },
            error: function () {
                $(".preloader").fadeOut();
                alert("Error fetching data for print.");
            }
        });
    }

    function createDate(dateString) {
        var date = new Date(dateString);
        var day = ("0" + date.getDate()).slice(-2);
        var month = ("0" + (date.getMonth() + 1)).slice(-2);
        var year = date.getFullYear();
        var hours = ("0" + date.getHours()).slice(-2);
        var minutes = ("0" + date.getMinutes()).slice(-2);
        var seconds = ("0" + date.getSeconds()).slice(-2);
        return day + "/" + month + "/" + year + " " + hours + ":" + minutes + ":" + seconds;
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
  window.addEventListener('load', function () {
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
    script.onload = function () {
      $('#custId, #vehicle_id').select2({
        allowClear: false,
        width: '100%'
      });
    };
    document.body.appendChild(script);
  });
</script>

<script>
    document.getElementById("footerYear").textContent = new Date().getFullYear();

    $(document).ready(function() {
        let table;

        // Dynamically load vehicles when customer is selected
        $('#custId').on('change', function () {
            var custId = $(this).val();
            if (custId) {
                $.ajax({
                    method: "POST",
                    url: "/report/get_vehicles_by_location",
                    data: JSON.stringify({ custId }),
                    contentType: "application/json",
                    dataType: "json",
                    beforeSend: function () {
                        $("#vehicle_id").html('<option value="">Loading...</option>');
                    },
                    success: function (res) {
                        let vehicles = res.msg || res; // Handle both {suc: 1, msg: [...]} and [...]
                        if (vehicles && vehicles.length > 0) {
                            let options = '<option value="">Select Vehicle Name</option>';
                            vehicles.forEach(veh => {
                                options += `<option value="${veh.vehicle_id}">${veh.vehicle_name}</option>`;
                            });
                            $("#vehicle_id").html(options).trigger('change');
                        } else {
                            $("#vehicle_id").html('<option value="">No Vehicles Found</option>').trigger('change');
                        }
                    },
                    error: function () {
                        $("#vehicle_id").html('<option value="">Error loading vehicles</option>').trigger('change');
                    }
                });
            } else {
                $("#vehicle_id").html('<option value="">Select Vehicle Name</option>').trigger('change');
            }
        });

        // Initialize DataTable
        function fetchDatatable() {
            var frm_dt = $('#frm_dt').val();
            var to_dt = $('#to_dt').val();
            var custId = $('#custId').val();
            var vehicle_id = $('#vehicle_id').val();
            var custName = $("#custId option:selected").text();
            var intype = $("input[name='intype']:checked").val()

            if(!frm_dt || !to_dt || !custId || !vehicle_id) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Missing Fields',
                    text: 'Please select all filters before fetching details.',
                });
                return;
            }

            $('#searchCred').html(`Combine report(vehicle wise) of location <b>${custName}</b> from <b>${frm_dt.split('T')[0]}</b> to <b>${to_dt.split('T')[0]}</b>`);
            $('#resultDiv').fadeIn();

            if ($.fn.DataTable.isDataTable('#combine-dev-wise-datatable')) {
                $('#combine-dev-wise-datatable').DataTable().destroy();
            }

            table = $('#combine-dev-wise-datatable').DataTable({
                "processing": true,
                "serverSide": true,
                "searching": false,
                "ordering": false,
                "lengthChange": true,
                "pageLength": 50,
                "ajax": {
                    "url": "/report/get_combine_repo_new",
                    "type": "POST",
                    "data": { frm_dt, to_dt, custId, vehicle_id,intype }
                },
                "columns": [
                    { 
                        "data": null, 
                        "render": function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        } 
                    },
                    { "data": "device_id" },
                    { "data": "vehicleType" },
                    { "data": "operator_name" },
                    { 
                        "data": "base_amt", 
                        "render": function(data) { return data ? parseFloat(data).toFixed(2) : "0.00"; }
                    },
                    { 
                        "data": "advance_amt", 
                        "render": function(data) { return data ? parseFloat(data).toFixed(2) : "0.00"; }
                    },
                    { 
                        "data": "cgst", 
                        "render": function(data) { return data ? parseFloat(data).toFixed(2) : "0.00"; }
                    },
                    { 
                        "data": "sgst", 
                        "render": function(data) { return data ? parseFloat(data).toFixed(2) : "0.00"; }
                    },
                    { 
                        "data": "igst", 
                        "render": function(data) { return data ? parseFloat(data).toFixed(2) : "0.00"; }
                    },
                    { 
                        "data": "paid_amt", 
                        "render": function(data) { return data ? parseFloat(data).toFixed(2) : "0.00"; }
                    },
                    { 
                        "data": null,
                        "render": function(data, type, row) {
                            let base = parseFloat(row.base_amt) || 0;
                            let adv = parseFloat(row.advance_amt) || 0;
                            let cgst = parseFloat(row.cgst) || 0;
                            let sgst = parseFloat(row.sgst) || 0;
                            let igst = parseFloat(row.igst) || 0;
                            return (base + adv + cgst + sgst + igst).toFixed(2);
                        }
                    }
                ],
                "drawCallback": function(settings) {
                    if (settings.json && settings.json.grandTotals) {
                        let gt = settings.json.grandTotals;
                        let base = parseFloat(gt.base_amt) || 0;
                        let adv = parseFloat(gt.advance_amt) || 0;
                        let cgst = parseFloat(gt.cgst) || 0;
                        let sgst = parseFloat(gt.sgst) || 0;
                        let igst = parseFloat(gt.igst) || 0;
                        let paid = parseFloat(gt.paid_amt) || 0;
                        
                        $('#tot_base').html(`<b>${base.toFixed(2)}</b>`);
                        $('#tot_advance').html(`<b>${adv.toFixed(2)}</b>`);
                        $('#tot_cgst').html(`<b>${cgst.toFixed(2)}</b>`);
                        $('#tot_sgst').html(`<b>${sgst.toFixed(2)}</b>`);
                        $('#tot_igst').html(`<b>${igst.toFixed(2)}</b>`);
                        $('#tot_paid').html(`<b>${paid.toFixed(2)}</b>`);
                        $('#tot_net').html(`<b>${(base + adv + cgst + sgst + igst).toFixed(2)}</b>`);
                    } else {
                        $('#tot_base, #tot_advance, #tot_cgst, #tot_sgst, #tot_igst, #tot_paid, #tot_net').html('<b>0.00</b>');
                    }
                }
            });
        }

        $('#btnSubmit').on('click', function () {
            fetchDatatable();
        });
    });

    function downloadExcel() {
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
        var vehicle_id = $('#vehicle_id').val();
        var custName = $("#custId option:selected").text();

        if(!frm_dt || !to_dt || !custId || !vehicle_id) {
            Swal.fire({
                icon: 'warning',
                title: 'Missing Fields',
                text: 'Please select all filters before downloading Excel.',
            });
            return;
        }

        $.ajax({
            type: "POST",
            url: "/report/get_combine_repo_new",
            data: { frm_dt, to_dt, custId, vehicle_id, start: 0, length: 10000 },
            success: function(response) {
                if (response.suc > 0 && response.data.length > 0) {
                    let excelData = [];
                    let gt_base = 0, gt_adv = 0, gt_cgst = 0, gt_sgst = 0, gt_igst = 0, gt_paid = 0, gt_net = 0;

                    response.data.forEach((row, index) => {
                        let base = parseFloat(row.base_amt) || 0;
                        let adv = parseFloat(row.advance_amt) || 0;
                        let cgst = parseFloat(row.cgst) || 0;
                        let sgst = parseFloat(row.sgst) || 0;
                        let igst = parseFloat(row.igst) || 0;
                        let paid = parseFloat(row.paid_amt) || 0;
                        let net = base + adv + cgst + sgst + igst;

                        gt_base += base;
                        gt_adv += adv;
                        gt_cgst += cgst;
                        gt_sgst += sgst;
                        gt_igst += igst;
                        gt_paid += paid;
                        gt_net += net;

                        excelData.push({
                            "Sl No.": index + 1,
                            "Machine Sl. No.": row.device_id,
                            "Vehicle Type": row.vehicleType,
                            "Operator Name": row.operator_name,
                            "Base Amount": base.toFixed(2),
                            "Advance Amount": adv.toFixed(2),
                            "CGST": cgst.toFixed(2),
                            "SGST": sgst.toFixed(2),
                            "IGST": igst.toFixed(2),
                            "Paid Amount": paid.toFixed(2),
                            "Net Amount": net.toFixed(2)
                        });
                    });

                    excelData.push({
                        "Sl No.": "",
                        "Machine Sl. No.": "",
                        "Vehicle Type": "",
                        "Operator Name": "Grand Total",
                        "Base Amount": gt_base.toFixed(2),
                        "Advance Amount": gt_adv.toFixed(2),
                        "CGST": gt_cgst.toFixed(2),
                        "SGST": gt_sgst.toFixed(2),
                        "IGST": gt_igst.toFixed(2),
                        "Paid Amount": gt_paid.toFixed(2),
                        "Net Amount": gt_net.toFixed(2)
                    });

                    let ws = XLSX.utils.json_to_sheet(excelData);
                    let wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, "Combine_Report_Vehicle");
                    XLSX.writeFile(wb, `Combine_Report_Vehicle_${frm_dt.split('T')[0]}_to_${to_dt.split('T')[0]}.xlsx`);
                } else {
                    Swal.fire('No Data', 'No records found for the selected criteria to download.', 'info');
                }
            },
            error: function() {
                Swal.fire('Error', 'Failed to fetch data for Excel export.', 'error');
            }
        });
    }

    function printDiv() {
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
        var vehicle_id = $('#vehicle_id').val();
        var custName = $("#custId option:selected").text();

        if(!frm_dt || !to_dt || !custId || !vehicle_id) {
            Swal.fire({
                icon: 'warning',
                title: 'Missing Fields',
                text: 'Please select all filters before printing.',
            });
            return;
        }

        $.ajax({
            type: "POST",
            url: "/report/get_combine_repo_new",
            data: { frm_dt, to_dt, custId, vehicle_id, start: 0, length: 10000 },
            success: function(response) {
                if (response.suc > 0 && response.data.length > 0) {
                    let printHtml = `
                    <html>
                    <head>
                        <title>Combine Report (Vehicle)</title>
                        <style>
                            body { font-family: Arial, sans-serif; }
                            .header { text-align: center; margin-bottom: 20px; }
                            .header h2 { margin: 0; padding: 0; }
                            .header h4 { margin: 5px 0; font-weight: normal; }
                            table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
                            th, td { border: 1px solid #000; padding: 6px; text-align: center; }
                            th { background-color: #f2f2f2; }
                        </style>
                    </head>
                    <body>
                        <div class="header">
                            <h2>Combine Report (Vehicle)</h2>
                            <h4>Combine report(vehicle wise) of location ${custName} from ${frm_dt.split('T')[0]} to ${to_dt.split('T')[0]}</h4>
                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Machine Sl. No.</th>
                                    <th>Vehicle Type</th>
                                    <th>Operator Name</th>
                                    <th>Base Amount</th>
                                    <th>Advance Amount</th>
                                    <th>CGST</th>
                                    <th>SGST</th>
                                    <th>IGST</th>
                                    <th>Paid Amount</th>
                                    <th>Net Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                    `;

                    let gt_base = 0, gt_adv = 0, gt_cgst = 0, gt_sgst = 0, gt_igst = 0, gt_paid = 0, gt_net = 0;

                    response.data.forEach((row, index) => {
                        let base = parseFloat(row.base_amt) || 0;
                        let adv = parseFloat(row.advance_amt) || 0;
                        let cgst = parseFloat(row.cgst) || 0;
                        let sgst = parseFloat(row.sgst) || 0;
                        let igst = parseFloat(row.igst) || 0;
                        let paid = parseFloat(row.paid_amt) || 0;
                        let net = base + adv + cgst + sgst + igst;

                        gt_base += base;
                        gt_adv += adv;
                        gt_cgst += cgst;
                        gt_sgst += sgst;
                        gt_igst += igst;
                        gt_paid += paid;
                        gt_net += net;

                        printHtml += `
                            <tr>
                                <td>${index + 1}</td>
                                <td>${row.device_id}</td>
                                <td>${row.vehicleType}</td>
                                <td>${row.operator_name}</td>
                                <td>${base.toFixed(2)}</td>
                                <td>${adv.toFixed(2)}</td>
                                <td>${cgst.toFixed(2)}</td>
                                <td>${sgst.toFixed(2)}</td>
                                <td>${igst.toFixed(2)}</td>
                                <td>${paid.toFixed(2)}</td>
                                <td>${net.toFixed(2)}</td>
                            </tr>
                        `;
                    });

                    printHtml += `
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" style="text-align: right; font-weight: bold;">Grand Total</td>
                                    <td><b>${gt_base.toFixed(2)}</b></td>
                                    <td><b>${gt_adv.toFixed(2)}</b></td>
                                    <td><b>${gt_cgst.toFixed(2)}</b></td>
                                    <td><b>${gt_sgst.toFixed(2)}</b></td>
                                    <td><b>${gt_igst.toFixed(2)}</b></td>
                                    <td><b>${gt_paid.toFixed(2)}</b></td>
                                    <td><b>${gt_net.toFixed(2)}</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </body>
                    </html>
                    `;

                    let printWin = window.open('', '_blank');
                    printWin.document.write(printHtml);
                    printWin.document.close();
                    printWin.focus();
                    setTimeout(function() {
                        printWin.print();
                        printWin.close();
                    }, 250);
                } else {
                    Swal.fire('No Data', 'No records found for the selected criteria to print.', 'info');
                }
            },
            error: function() {
                Swal.fire('Error', 'Failed to fetch data for printing.', 'error');
            }
        });
    }
</script>
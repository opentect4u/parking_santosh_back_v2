<script>
    $("#btnExcel").on("click", function () {

        var frm_dt = $("#frm_dt").val();
        var to_dt = $("#to_dt").val();
        var pay_mode = $("#pay_mode").val();
        var custId = $("#custId").val();
        var operator_id = "A";

        if (!frm_dt || !to_dt || !pay_mode || !custId) {
            alert("Please select all filters before downloading!");
            return;
        }

        $.ajax({
            url: "/report/get_details_report_excel",
            type: "POST",
            data: { frm_dt, to_dt, pay_mode, custId, operator_id },
            beforeSend: function () {
                $(".preloader").fadeIn();
            },
            success: function (res) {
                if (res.suc === 1) {
                    generateExcel(res.data);
                } else {
                    alert("No Data Found!");
                }
            },
            complete: function () {
                $(".preloader").fadeOut();
            }
        });
    });

    function generateExcel(data) {

        let rows = [];

        let total_base = 0, total_adv = 0, total_cgst = 0, total_sgst = 0, total_paid_amt = 0,
            total_paid = 0, total_cash = 0, total_upi = 0;

        // HEADER
        rows.push([
            "#", "Receipt No", "Receipt No", "Date Time In", "Machine In",
            "Vehicle Type", "Vehicle No", "Date Time Out",
            "Machine Out", "Base Amt", "Advance Amt",
            "CGST", "SGST", "Paid Amt", "Net Amt", "Mode", "Operator Name"
        ]);

        // DETAILS ROWS
        data.forEach((dt, i) => {

            let netAmt = Number(dt.paid_amt);

            rows.push([
                i + 1,
                dt.receipt_no,
                dt.receipt_no ? String(dt.receipt_no).slice(-5) : "",
                dt.date_time_in,
                dt.device_id,
                dt.vehicle_name,
                dt.vehicle_no,
                dt.date_time_out,
                dt.device_id_out,
                dt.base_amt,
                dt.advance_amt,
                dt.cgst,
                dt.sgst,
                dt.paid_amt,
                netAmt,
                dt.pay_mode === "U" ? "UPI" : dt.pay_mode === "C" ? "CASH" : "",
                dt.operator_name
            ]);

            total_base += Number(dt.base_amt);
            total_adv += Number(dt.advance_amt);
            total_cgst += Number(dt.cgst);
            total_sgst += Number(dt.sgst);
            total_paid_amt += Number(dt.paid_amt);
            total_paid += Number(netAmt);

            if (dt.pay_mode === "C") total_cash += Number(netAmt);
            if (dt.pay_mode === "U") total_upi += Number(netAmt);
        });

        // BLANK ROW
        rows.push([]);

        // EXACT TOTAL ROW LIKE YOUR SCREENSHOT
        rows.push([
            "Total",     // Column A
            "", "", "", "", "", "", "", "",   // B–I empty
            total_base,   // Base Amt (column J)
            total_adv,    // Advance Amt (column K)
            total_cgst,   // CGST (column L)
            total_sgst,   // SGST (column M)
            total_paid_amt,   // Paid Amt (column N)
            total_paid,   // Net Amt (column O)
            "",
            ""
        ]);

        // NEXT ROW: TOTAL UPI
        rows.push([
            "Total UPI:", total_upi
        ]);

        // NEXT ROW: TOTAL CASH
        rows.push([
            "Total Cash:", total_cash
        ]);

        // GENERATE
        let workbook = XLSX.utils.book_new();
        let worksheet = XLSX.utils.aoa_to_sheet(rows);

        // FORCE COLUMN B (Receipt No) AS TEXT
        let totalRows = rows.length;
        for (let i = 2; i <= totalRows; i++) {
            let cellRef = "B" + i;   // B2, B3, B4...
            if (worksheet[cellRef]) {
                worksheet[cellRef].z = "@"; // force text format
                worksheet[cellRef].t = "s"; // mark as text type
            }
        }

        XLSX.utils.book_append_sheet(workbook, worksheet, "Detail Report");

        XLSX.writeFile(workbook, "Detail_Report_All.xlsx");
    }
</script>


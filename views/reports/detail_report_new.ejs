<script>
    let table; // Global reference for dataTable

    // Clear the table when location changes
    $('#custId').on('change', function () {
        if (table) {
            table.clear().draw();
        }
        $('#resultDiv').hide();
    });

    $('#btnVehicleReset').on('click', function () {
        $('#vehicleSearch').val('');
        // $('#resultDiv table tbody tr').show();
        table.ajax.reload();
    });

    // 1️⃣ Clear vehicle search and totals when location changes
    $('#custId').on('change', function () {
        $('#vehicleSearch').val('');               // Clear vehicle search input
        $('#resultDiv table tbody tr').empty();     // Show all rows again
        $('#vehicleSearchSection').hide();         // Hide vehicle search section until new search
        $('#base_amt, #advance_amt, #cgst, #sgst, #other_chrges, #tot_amt, #tot_upi, #tot_cash').text('0.00'); // Reset totals
    });


    $('#btnSubmit').on('click', function () {
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
        var pay_mode = $('#pay_mode').val();
        var operator_id = "A"; // Default to All Operators since dropdown is hidden
        var custName = $("#custId option:selected").text();
        var vehicle_no = $('#vehicleSearch').val();

        if (frm_dt !== '' && to_dt !== '' && custId !== '' && pay_mode !== '') {

            if (table) {
                table.destroy();     // destroy previous instance
                $('#cust-datatable tbody').empty();
            }

            $('#resultDiv').show();
            $('#vehicleSearchSection').hide();
            $('#resultDiv table tbody').empty();
            $('#searchCred').html(`<b>Detail Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);

            table = $('#cust-datatable').DataTable({
                processing: true,
                serverSide: false,
                searching: false,
                lengthChange: true,
                pageLength: 50,

                ajax: {
                    url: "/report/get_details_report_new",
                    type: "POST",
                    dataSrc: function (json) {
                        if (!json) {
                            return [];
                        }
                        if (json.suc === 1 && Array.isArray(json.msg)) {
                            return json.msg;
                        }
                        return [];
                    },
                    data: function (d) {
                        d.frm_dt = $('#frm_dt').val();
                        d.to_dt = $('#to_dt').val();
                        d.custId = $('#custId').val();
                        d.pay_mode = $('#pay_mode').val();
                        d.operator_id = $('#operator_id').val();

                        d.vehicle_no = $('#vehicleSearch').val();
                        d.intype = $("input[name='intype']:checked").val();
                    },
                    beforeSend: function () {
                        $('#pageLoader').fadeIn();
                    },
                    complete: function () {
                        $('#pageLoader').fadeOut();
                    },
                    error: function (xhr, status, error) {
                        console.error('Details report load error:', status, error);
                        $('#pageLoader').fadeOut();
                    }
                },
                drawCallback: function (settings) {
                    console.log("DRAW CALLBACK FIRED"); // 👈 DEBUG
                    $('#vehicleSearchSection').show();
                },
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { data: "receipt_no" },
                    {
                        data: "receipt_no",
                        render: d => d ? String(d).slice(-5) : ''
                    },
                    { data: "date_time_in" },
                    { data: "device_id" },
                    { data: "vehicle_name" },
                    { data: "vehicle_no" },
                    { data: "date_time_out" },
                    { data: "device_id_out" },
                    {
                        data: "base_amt",
                        render: d => Number(d).toFixed(2)
                    },
                    {
                        data: "advance_amt",
                        render: d => Number(d).toFixed(2)
                    },
                    {
                        data: "cgst",
                        render: d => Number(d).toFixed(2)
                    },
                    {
                        data: "sgst",
                        render: d => Number(d).toFixed(2)
                    },
                    {
                        data: "paid_amt",
                        render: d => Number(d).toFixed(2)
                    },
                    {
                        data: null,
                        render: d => Number(d.paid_amt).toFixed(2)
                    },
                    {
                        data: "pay_mode",
                        render: d => d === 'U' ? 'UPI' : d === 'C' ? 'CASH' : ''
                    },
                    { data: "operator_name" }
                ],
                footerCallback: function (row, data, start, end, display) {
                    var api = this.api();

                    var json = api.ajax.json();

                    if (json && json.totals) {
                        $('#base_amt').text(Number(json.totals.base_amt).toFixed(2));
                        $('#advance_amt').text(Number(json.totals.advance_amt).toFixed(2));
                        $('#cgst').text(Number(json.totals.cgst).toFixed(2));
                        $('#sgst').text(Number(json.totals.sgst).toFixed(2));
                        $('#paid_amt').text(Number(json.totals.paid_amt).toFixed(2));
                        // $('#other_chrges').text(Number(json.totals.other_charges).toFixed(2));
                        $('#tot_amt').text(Number(json.totals.tot_amt).toFixed(2));

                        if (pay_mode == 'A') {
                            $('#tot_upi').parent().show();
                            $('#tot_cash').parent().show();
                            $('#tot_upi').text(Number(json.grandTotals.tot_upi).toFixed(2));
                            $('#tot_cash').text(Number(json.grandTotals.tot_cash).toFixed(2));
                        } else if (pay_mode == 'U') {
                            $('#tot_upi').parent().show();
                            $('#tot_cash').parent().hide();
                            $('#tot_upi').text(Number(json.grandTotals.tot_upi).toFixed(2));
                            $('#tot_cash').text('0.00');
                        } else if (pay_mode == 'C') {
                            $('#tot_upi').parent().hide();
                            $('#tot_cash').parent().show();
                            $('#tot_upi').text('0.00');
                            $('#tot_cash').text(Number(json.grandTotals.tot_cash).toFixed(2));
                        }
                    }
                }
            });
            $('#resultDiv').show();
        }
    });

    /* ADD LOADER ON PAGINATION */
    $('#cust-datatable').on('page.dt', function () {
        $('#pageLoader').fadeIn();
    });

    $('#cust-datatable').on('draw.dt', function () {
        $('#pageLoader').fadeOut();
    });
</script>


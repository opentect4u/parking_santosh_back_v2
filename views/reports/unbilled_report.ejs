<script>
  window.addEventListener('load', function () {
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
    script.onload = function () {
      $('#custId').select2({
        placeholder: "Select Location Name",
        allowClear: true,
        width: '100%'
      });
    };
    document.body.appendChild(script);
  });
</script>

<script>
  $(document).ready(function () {
    let table;

    // Clear the table when location changes
    $('#custId').on('change', function () {
      if (table) {
        table.clear().draw();
      }
      $('#resultDiv').hide();
      $('#tot_amt').text('0.00');
    });

    $('#btnSubmit').on('click', function () {
      var frm_dt = $('#frm_dt').val();
      var to_dt = $('#to_dt').val();
      var custId = $('#custId').val();
      var intype = $("input[name='intype']:checked").val();
      var custName = $("#custId option:selected").text(); // Get selected location name

      if (frm_dt !== '' && to_dt !== '' && custId !== '') {
        if (table) {
          table.destroy();
          $('#unbilled-datatable tbody').empty();
        }

        $('#resultDiv').show();
        $('#searchCred').html(`<b>Unbilled Report of ${custName} from ${createDate(frm_dt)} to ${createDate(to_dt)}</b>`);

        table = $('#unbilled-datatable').DataTable({
          processing: true,
          serverSide: true,
          searching: true, // Allows global search input (searches vehicle_no in backend)
          lengthChange: true,
          pageLength: 50,
          ajax: {
            url: "/report/get_unbilled_report",
            type: "POST",
            data: function (d) {
              d.frm_dt = $('#frm_dt').val();
              d.to_dt = $('#to_dt').val();
              d.custId = $('#custId').val();
              d.intype = $("input[name='intype']:checked").val();
            },
            beforeSend: function () {
              $(".preloader").fadeIn();
            },
            complete: function () {
              $(".preloader").fadeOut();
            }
          },
          drawCallback: function (settings) {
            if (settings.json && settings.json.grandTotals) {
              let totalAdvance = settings.json.grandTotals.advance_amt ? parseFloat(settings.json.grandTotals.advance_amt) : 0;
              $('#tot_amt').text('₹ ' + totalAdvance.toFixed(2));
            } else {
              $('#tot_amt').text('₹ 0.00');
            }
          },
          columns: [
            {
              data: null,
              render: function (data, type, row, meta) {
                return meta.row + meta.settings._iDisplayStart + 1;
              }
            },
            { data: "receipt_no" },
            {
              data: "date_time_in",
              render: function (data) {
                return createDateTime(data);
              }
            },
            { data: "device_id" },
            { data: "vehicle_name" },
            { data: "vehicle_no" },
            {
              data: "advance_amt",
              render: function (data) {
                let advAmt = data ? parseFloat(data) : 0;
                return `<span class="text-dark fw-bold">₹ ${advAmt.toFixed(2)}</span>`;
              }
            },
            { data: "operator_name" }
          ]
        });
      }
    });
  });
</script>

<script>
  function downloadExcel() {
    // Get the table element
    var table = document.querySelector("#resultDiv table");

    if (!table) {
      alert("No data available to export!");
      return;
    }

    // Convert table to worksheet with raw set to true to prevent scientific notation formatting
    var workbook = XLSX.utils.book_new();
    var worksheet = XLSX.utils.table_to_sheet(table, { raw: true });

    XLSX.utils.book_append_sheet(workbook, worksheet, "Unbilled Report");

    // Download Excel file
    XLSX.writeFile(workbook, "Unbilled_Report.xlsx");
  }
</script>

<script>
  function printDiv() {
    var divToPrint = document.getElementById('resultDiv').cloneNode(true);
    // Remove any non-printable elements from the clone before printing
    var noPrintElements = divToPrint.querySelectorAll('.no-print');
    noPrintElements.forEach(function (el) {
      el.parentNode.removeChild(el);
    });

    var WindowObject = window.open('', 'Print-Window');
    WindowObject.document.open();
    WindowObject.document.writeln('<!DOCTYPE html>');
    WindowObject.document.writeln('<html><head><title>Unbilled Report</title><style type="text/css">');

    WindowObject.document.writeln('@media print { ' +
      ' body { font-family: "Segoe UI", Arial, sans-serif; color: #000; } ' +
      ' h5 { text-align: center; font-size: 18px; margin-bottom: 20px; } ' +
      ' table { width: 100%; border-collapse: collapse; font-size: 12px; margin: 0 auto; } ' +
      ' th, td { border: 1px solid #000; padding: 8px; text-align: center; } ' +
      ' th { background-color: #e9ecef !important; -webkit-print-color-adjust: exact; font-weight: bold; } ' +
      ' tfoot td { font-weight: bold; background-color: #f8f9fa !important; -webkit-print-color-adjust: exact; } ' +
      ' .no-print { display: none !important; } ' +
      ' .dataTables_length, .dataTables_filter, .dataTables_info, .dataTables_paginate, .dt-buttons { display: none !important; } ' +
      ' } ' +
      ' /* Screen preview styles */ ' +
      ' body { font-family: "Segoe UI", Arial, sans-serif; padding: 20px; color: #000; } ' +
      ' h5 { text-align: center; font-size: 20px; margin-bottom: 20px; } ' +
      ' table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 0 auto; } ' +
      ' th, td { border: 1px solid #000; padding: 10px; text-align: center; } ' +
      ' th { background-color: #e9ecef; font-weight: bold; } ' +
      ' tfoot td { font-weight: bold; background-color: #f8f9fa; } ' +
      ' .no-print { display: none !important; } ' +
      ' .dataTables_length, .dataTables_filter, .dataTables_info, .dataTables_paginate, .dt-buttons { display: none !important; } ' +
      '</style>');

    WindowObject.document.writeln('</head><body>');
    WindowObject.document.writeln(divToPrint.innerHTML);
    WindowObject.document.writeln('<script>window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 500); }<\/script>');
    WindowObject.document.writeln('</body></html>');
    WindowObject.document.close();
  }
</script>

<!-- Floating Scroll Arrows -->
<div class="floating-arrows no-print" id="floatingArrowsContainer">
  <button id="btn-scroll-up" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Go to top">
    <i class="fas fa-arrow-up"></i>
  </button>
  <button id="btn-scroll-down" onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})"
    title="Go to bottom">
    <i class="fas fa-arrow-down"></i>
  </button>
</div>

<script>
  window.addEventListener('scroll', function () {
    var upBtn = document.getElementById('btn-scroll-up');
    var downBtn = document.getElementById('btn-scroll-down');
    var arrowContainer = document.getElementById('floatingArrowsContainer');
    var resultDiv = document.getElementById('resultDiv');

    // Only show arrows if the data table is visible and page is scrollable
    if (resultDiv && resultDiv.style.display !== 'none' && document.documentElement.scrollHeight > window.innerHeight + 100) {
      arrowContainer.style.display = 'flex';

      var scrollPosition = window.scrollY || document.documentElement.scrollTop;
      var bottomPosition = document.documentElement.scrollHeight - document.documentElement.clientHeight;

      if (scrollPosition <= 50) {
        // At top
        upBtn.style.display = 'none';
        downBtn.style.display = 'flex';
      } else if (scrollPosition >= bottomPosition - 50) {
        // At bottom
        upBtn.style.display = 'flex';
        downBtn.style.display = 'none';
      } else {
        // In middle
        upBtn.style.display = 'flex';
        downBtn.style.display = 'flex';
      }
    } else {
      arrowContainer.style.display = 'none';
    }
  });

  // Trigger once on load to set initial state
  window.dispatchEvent(new Event('scroll'));

  // Set footer year
  if(document.getElementById("footerYear")) {
      document.getElementById("footerYear").textContent = new Date().getFullYear();
  }
</script>
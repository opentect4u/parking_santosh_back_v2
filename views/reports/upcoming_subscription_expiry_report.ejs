        WindowObject.document.writeln('<style>@media print { @page { size: landscape; margin: 1cm; } }</style>');
        WindowObject.document.writeln('</head><body onload="window.print(); setTimeout(function(){ window.close(); }, 500);">');

        let searchCred = document.getElementById('searchCred') ? document.getElementById('searchCred').innerText : 'Monthly Subscription Report';
        WindowObject.document.writeln('<h3 style="text-align:center; font-family: Arial, sans-serif;">' + searchCred + '</h3>');
        WindowObject.document.writeln(tableHTML);
        WindowObject.document.writeln('</body></html>');
        WindowObject.document.close();
    }
</script>

<!-- Floating Scroll Arrows -->
<div class="floating-arrows no-print" id="floatingArrowsContainer">
    <button id="btn-scroll-up" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Go to top">
        <i class="fas fa-arrow-up"></i>
    </button>
    <button id="btn-scroll-down" onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})"
        title="Go to bottom">
        <i class="fas fa-arrow-down"></i>
    </button>
</div>

<script>
    window.addEventListener('scroll', function () {
        var upBtn = document.getElementById('btn-scroll-up');
        var downBtn = document.getElementById('btn-scroll-down');
        var arrowContainer = document.getElementById('floatingArrowsContainer');
        var resultDiv = document.getElementById('resultDiv');

        // Only show arrows if the data table is visible and page is scrollable
        if (resultDiv && resultDiv.style.display !== 'none' && document.documentElement.scrollHeight > window.innerHeight + 100) {
            arrowContainer.style.display = 'flex';

            var scrollPosition = window.scrollY || document.documentElement.scrollTop;
            var bottomPosition = document.documentElement.scrollHeight - document.documentElement.clientHeight;

            if (scrollPosition <= 50) {
                // At top
                upBtn.style.display = 'none';
                downBtn.style.display = 'flex';
            } else if (scrollPosition >= bottomPosition - 50) {
                // At bottom
                upBtn.style.display = 'flex';
                downBtn.style.display = 'none';
            } else {
                // In middle
                upBtn.style.display = 'flex';
                downBtn.style.display = 'flex';
            }
        } else {
            arrowContainer.style.display = 'none';
        }
    });

    // Trigger once on load to set initial state
    window.dispatchEvent(new Event('scroll'));
</script>
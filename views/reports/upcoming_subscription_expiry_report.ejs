<script>
    let table; // Global reference for dataTable

    // Clear the table when location changes
    $('#custId').on('change', function () {
        if (table) {
            table.clear().draw();
        }
        $('#resultDiv').hide();
    });

    $('#btnVehicleReset').on('click', function () {
        $('#vehicleSearch').val('');
        // $('#resultDiv table tbody tr').show();
        table.ajax.reload();
    });

    // 1️⃣ Clear vehicle search and totals when location changes
    $('#custId').on('change', function () {
        $('#vehicleSearch').val('');               // Clear vehicle search input
        $('#resultDiv table tbody tr').empty();     // Show all rows again
        $('#vehicleSearchSection').hide();         // Hide vehicle search section until new search
        $('#base_amt, #advance_amt, #cgst, #sgst, #other_chrges, #tot_amt, #tot_upi, #tot_cash').text('0.00'); // Reset totals
    });


    $('#btnSubmit').on('click', function () {
        
        var frm_dt = $('#frm_dt').val();
        var to_dt = $('#to_dt').val();
        var custId = $('#custId').val();
        var pay_mode = $('#pay_mode').val();
        var operator_id = "A"; // Default to All Operators since dropdown is hidden
        var custName = $("#custId option:selected").text();
        var vehicle_no = $('#vehicleSearch').val();

        if (custId !== '' && pay_mode !== '') {

      
            if (table) {
                table.destroy();     // destroy previous instance
                $('#cust-datatable tbody').empty();
            }

            $('#resultDiv').show();
            $('#vehicleSearchSection').hide();
            $('#resultDiv table tbody').empty();
            $('#searchCred').html(`<b>Detail Report of ${custName} </b>`);

            table = $('#cust-datatable').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                lengthChange: true,
                pageLength: 50,

                ajax: {
                    url: "/report/upcoming_subscription_expiry",
                    type: "POST",
                    data: function (d) {
                        d.exp_type = $('#exp_type').val();
                        d.custId = $('#custId').val();
                        d.pay_mode = $('#pay_mode').val();
                        d.vehicle_no = $('#vehicleSearch').val();
                    },
                    beforeSend: function () {
                        $('#pageLoader').fadeIn();
                    },
                    complete: function () {
                        $('#pageLoader').fadeOut();
                    }
                },
                drawCallback: function (settings) {
                    console.log("DRAW CALLBACK FIRED");
                    $('#vehicleSearchSection').show();
                },
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { data: "receipt_no" },
                    { data: "created_at", render: d => d ? createDate(d) : '' },
                    { data: "start_date", render: d => d ? createDate(d) : '' },
                    { data: "end_date", render: d => d ? createDate(d) : '' },
                    { data: "remaining_days", render: d => (d !== undefined && d !== null) ? d : '' },
                    { data: "vehicle_no" },
                    { data: "device_id" },
                    { data: "subscription_type" },
                    { data: "status" },
                    { data: "base_amt", render: d => Number(d).toFixed(2) },
                    { data: "cgst", render: d => Number(d).toFixed(2) },
                    { data: "sgst", render: d => Number(d).toFixed(2) },
                    { data: "igst", render: d => Number(d).toFixed(2) },
                    { data: "paid_amt", render: d => Number(d).toFixed(2) },
                    { data: "pay_mode", render: d => d === 'U' ? 'UPI' : d === 'C' ? 'CASH' : '' }
                ],
                footerCallback: function (row, data, start, end, display) {
                    var api = this.api();
                    var json = api.ajax.json();

                    if (json && json.totals) {
                        $('#base_amt').text(Number(json.totals.base_amt).toFixed(2));
                        $('#cgst').text(Number(json.totals.cgst).toFixed(2));
                        $('#sgst').text(Number(json.totals.sgst).toFixed(2));
                        $('#igst').text(Number(json.totals.igst).toFixed(2));
                        $('#paid_amt').text(Number(json.totals.paid_amt).toFixed(2));

                        if (pay_mode == 'A') {
                            $('#tot_upi').parent().show();
                            $('#tot_cash').parent().show();
                            $('#tot_upi').text(Number(json.grandTotals.tot_upi).toFixed(2));
                            $('#tot_cash').text(Number(json.grandTotals.tot_cash).toFixed(2));
                        } else if (pay_mode == 'U') {
                            $('#tot_upi').parent().show();
                            $('#tot_cash').parent().hide();
                            $('#tot_upi').text(Number(json.grandTotals.tot_upi).toFixed(2));
                            $('#tot_cash').text('0.00');
                        } else if (pay_mode == 'C') {
                            $('#tot_upi').parent().hide();
                            $('#tot_cash').parent().show();
                            $('#tot_upi').text('0.00');
                            $('#tot_cash').text(Number(json.grandTotals.tot_cash).toFixed(2));
                        }
                    }
                }
            });
            $('#resultDiv').show();
        }
    });

    /* ADD LOADER ON PAGINATION */
    $('#cust-datatable').on('page.dt', function () {
        $('#pageLoader').fadeIn();
    });

    $('#cust-datatable').on('draw.dt', function () {
        $('#pageLoader').fadeOut();
    });
</script>


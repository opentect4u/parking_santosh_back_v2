<script>
  const hours = new Date().getHours();
  let greeting;

  if (hours < 12) {
    greeting = "Good Morning";
  } else if (hours < 17) {
    greeting = "Good Afternoon";
  } else if (hours < 20) {
    greeting = "Good Evening";
  } else {
    greeting = "Good Night";
  }

  // insert greeting + username into the span
  document.getElementById("greeting").innerText = `${greeting}, <%= user.userData.user_name %>`;
</script>


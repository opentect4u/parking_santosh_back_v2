    opacity: 1;
  }
  .sidebar-nav #sidebarnav .sidebar-item.selected>.sidebar-link i,
  .sidebar-nav #sidebarnav .sidebar-item.selected>.sidebar-link svg,
  .sidebar-nav #sidebarnav .sidebar-item.selected>.sidebar-link .feather {
    color: #ffffff !important;
    stroke: #ffffff !important;
  }

  .scroll-sidebar {
    height: 100%;
    overflow-y: auto;
    padding-top: 1rem;
  }

  .sidebar-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-item {
    margin: 0; 
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px; /* Uniform padding */
    margin: 5px 10px; /* Margin for the box */
    font-size: 15px;
    font-weight: 500;
    color: #065f46 !important; /* Dark green text */
    background-color: #e6f4ea; /* Light green box */
    border-radius: 10px; /* Rounded box */
    transition: all 0.3s ease;
  }

  /* When sidebar is collapsed, absolutely lock the margins and padding to prevent shifting on hover */
  #main-wrapper[data-sidebartype="mini-sidebar"] .left-sidebar .sidebar-nav #sidebarnav .sidebar-item > .sidebar-link,
  #main-wrapper[data-sidebartype="mini-sidebar"] .left-sidebar:hover .sidebar-nav #sidebarnav .sidebar-item > .sidebar-link,
  #main-wrapper[data-sidebartype="mini-sidebar"] .left-sidebar .sidebar-nav #sidebarnav .sidebar-item > .sidebar-link:hover,
  #main-wrapper.mini-sidebar .left-sidebar .sidebar-nav #sidebarnav .sidebar-item > .sidebar-link,
  #main-wrapper.mini-sidebar .left-sidebar:hover .sidebar-nav #sidebarnav .sidebar-item > .sidebar-link,
  #main-wrapper.mini-sidebar .left-sidebar .sidebar-nav #sidebarnav .sidebar-item > .sidebar-link:hover {
    padding: 12px 0 !important;
    justify-content: center !important;
    margin: 5px 10px !important;
    width: 45px !important; /* 65px container - 20px margin */
    border-radius: 10px !important;
    position: relative;
    overflow: visible;
    transition: none !important; /* Kill all dancing animations */
    transform: none !important;
  }

  /* Prevent auto-expand on hover or click when mini-sidebar is active */
  #main-wrapper[data-sidebartype="mini-sidebar"] .left-sidebar,
  #main-wrapper[data-sidebartype="mini-sidebar"] .left-sidebar:hover,
  #main-wrapper.mini-sidebar .left-sidebar,

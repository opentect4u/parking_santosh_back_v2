<script>
  $(document).ready(function() {
    // Kill any native template hover event loops that cause "dancing"
    $(".left-sidebar, .sidebar-item").off('mouseenter mouseleave');
    
    // Custom floating tooltip for mini-sidebar
    $(".sidebar-link").hover(function(e) {
      if ($("#main-wrapper").hasClass("mini-sidebar") || $("#main-wrapper").attr("data-sidebartype") === "mini-sidebar") {
        var text = $(this).find(".hide-menu").text().trim();
        if (!text) return;
        
        if ($('#custom-sidebar-tooltip').length === 0) {
          $('body').append('<div id="custom-sidebar-tooltip" style="position:fixed; background:#1f2937; color:#fff; padding:6px 12px; border-radius:6px; font-size:13px; font-weight:500; z-index:999999; pointer-events:none; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"></div>');
        }
        
        var rect = this.getBoundingClientRect();
        $('#custom-sidebar-tooltip').text(text).css({
          top: rect.top + (rect.height / 2) - 15 + 'px',
          left: rect.left + rect.width + 10 + 'px',
          display: 'block'
        });
      }
    }, function() {
      $('#custom-sidebar-tooltip').hide();
    });
  });

  document.addEventListener("DOMContentLoaded", function () {
    // Get current path
    const currentPath = window.location.pathname;
    
    // Get all sidebar links
    const links = document.querySelectorAll('.sidebar-link');
    
    links.forEach(link => {
      const parentLi = link.closest('.sidebar-item');
      const href = link.getAttribute('href');
      let isActive = (href === currentPath);
      
      // Also keep the Location sidebar active if we are on edit_customer page
      if (currentPath.includes('edit_customer') && href === '/superadmin/customer') {
        isActive = true;
      }
      
      // Keep Report Password active on its edit page
      if (currentPath.includes('edit_report_pass') && href === '/superadmin/report_pass') {
        isActive = true;
      }

      // Keep Header Footer active on its edit page
      if (currentPath.includes('edit_header_footer') && href === '/superadmin/header_footer') {
        isActive = true;
      }

      // Keep Device Setting active on its edit page
      if (currentPath.includes('edit_device_setting') && href === '/superadmin/device_setting') {
        isActive = true;
      }
      
      // Match link href with current path
      if (isActive) {
        parentLi.classList.add('selected'); // highlight this item
        
        // If inside a submenu, open the parent
        const collapse = link.closest('.collapse');
        if (collapse) {
          collapse.classList.add('show'); // open submenu
          collapse.style.display = 'block'; // force display block just in case
          const parentItem = collapse.closest('.sidebar-item');
          if (parentItem) {
            parentItem.classList.add('open', 'active', 'selected');
            const parentLink = parentItem.querySelector('a.has-arrow');
            if(parentLink) {
                parentLink.classList.add('active');
                parentLink.setAttribute('aria-expanded', 'true');
            }
          }
        }
        
        // Automatically scroll the sidebar container to show the active item
        setTimeout(() => {
          const scrollContainer = document.querySelector('.scroll-sidebar');
          if (scrollContainer && parentLi) {
            scrollContainer.scrollTo({
              top: parentLi.offsetTop - (scrollContainer.clientHeight / 2) + (parentLi.clientHeight / 2),
              behavior: 'smooth'
            });
          } else if (parentLi) {
            parentLi.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }, 300);
      } else {
        parentLi.classList.remove('selected');
      }
    });
  });
</script>
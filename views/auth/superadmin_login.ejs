<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Bootstrap -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='%2310b981' viewBox='0 0 16 16'><path d='M2.52 3.515A2.5 2.5 0 0 1 4.82 2h6.362c1 0 1.904.596 2.298 1.515l.792 1.848c.075.175.21.319.38.404.5.25.855.715.965 1.262l.335 1.679c.033.161.049.325.049.49v.413c0 .814-.39 1.543-1 1.997V13.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-1.338c-1.292.048-2.745.088-4 .088s-2.708-.04-4-.088V13.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-1.892c-.61-.454-1-1.183-1-1.997v-.413a2.5 2.5 0 0 1 .049-.49l.335-1.68c.11-.546.465-1.012.964-1.261a.807.807 0 0 0 .381-.404l.792-1.848ZM3 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2m10 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2M6 8a1 1 0 0 0 0 2h4a1 1 0 1 0 0-2zM2.906 5.189a.51.51 0 0 0 .497.731c.91-.073 3.35-.17 4.597-.17 1.247 0 3.688.097 4.597.17a.51.51 0 0 0 .497-.731l-.956-1.913A.5.5 0 0 0 11.691 3H4.309a.5.5 0 0 0-.447.276L2.906 5.19Z'/></svg>">
  <title>Santosh Park || Superadmin Sign In</title>

  <style>
    :root {
      --primary: #059669;
      /* Emerald matching new background */
      --primary-hover: #047857;
      --text-dark: #1f2937;
      --text-muted: #6b7280;
    }

    body {
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 20px;
      position: relative;
      overflow: hidden;
      /* Hide the background zoom overflow */
    }

    body::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background-image: url('https://images.unsplash.com/photo-1506521781263-d8422e82f27a?auto=format&fit=crop&q=80&w=1920');
      background-size: cover;
      background-position: center;
      z-index: -2;
      animation: cinematicZoom 20s infinite alternate ease-in-out;
    }

    body::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: rgba(2, 44, 34, 0.7);
      /* dark emerald overlay */
      z-index: -1;
    }

    @keyframes cinematicZoom {
      0% {
        transform: scale(1);
      }

      100% {
        transform: scale(1.15);
      }
    }

    .auth-container {
      position: relative;
      z-index: 1;
      max-width: 960px;
      width: 100%;
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      display: flex;
      overflow: hidden;
      min-height: 500px;
    }

    /* LEFT SIDE WITH IMAGE */
    .auth-image-side {
      flex: 1;
      position: relative;
      background-image: url('https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?auto=format&fit=crop&q=80&w=1000');
      /* Payment terminal/receipt */
      background-size: cover;
      background-position: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px;
      color: white;
      text-align: center;
    }

    /* Dark overlay so text/logo is readable */
    .auth-image-side::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: rgba(30, 35, 55, 0.7);
      z-index: 0;
    }

    /* 3D Glossy Reflection Effect */
    .auth-image-side::after {
      content: '';
      position: absolute;
      top: 0;
      left: -150%;
      width: 50%;
      height: 100%;
      background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.25) 50%, rgba(255, 255, 255, 0) 100%);
      transform: skewX(-25deg);
      animation: 3dShine 7s infinite ease-in-out;
      z-index: 2;
      pointer-events: none;
    }

    @keyframes 3dShine {
      0% {
        left: -150%;
      }

      15% {
        left: 200%;
      }

      100% {
        left: 200%;
      }
    }

    .auth-image-side .content-overlay {
      position: relative;
      z-index: 3;
    }

    .auth-image-side h2 {
      font-weight: 700;
      font-size: 1.6rem;
      margin-bottom: 5px;
    }

    .auth-image-side p {
      font-size: 0.95rem;
      opacity: 0.9;
    }

    /* RIGHT SIDE WITH FORM */
    .auth-form-side {
      flex: 1.1;
      padding: 40px 50px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: #ffffff;
    }

    .auth-form-side h3 {
      font-weight: 700;
      font-size: 1.8rem;
      color: var(--text-dark);
      margin-bottom: 5px;
    }

    .auth-form-side p.subtitle {
      color: var(--text-muted);
      margin-bottom: 30px;
      font-size: 0.95rem;
    }

    /* NEW INPUT DESIGN */
    .input-group-custom {
      margin-bottom: 20px;
      position: relative;
    }

    .input-group-custom label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
      color: var(--text-dark);
      font-size: 0.9rem;
    }

    .input-icon {
      position: absolute;
      left: 16px;
      top: 36px;
      color: #9ca3af;
      font-size: 1.1rem;
      pointer-events: none;
      transition: all 0.3s ease;
    }

    .form-control {
      width: 100%;
      padding: 12px 16px 12px 45px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      font-size: 0.95rem;
      color: var(--text-dark);
      transition: all 0.2s ease;
    }

    .form-control::placeholder {
      color: #9ca3af;
    }

    .form-control:focus {
      background: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
      outline: none;
    }

    .form-control:focus+.input-icon {
      color: var(--primary);
    }

    .password-toggle {
      position: absolute;
      right: 16px;
      top: 36px;
      color: #9ca3af;
      font-size: 1.1rem;
      cursor: pointer;
      transition: color 0.3s;
    }

    .password-toggle:hover {
      color: var(--text-dark);
    }

    /* NEW BUTTON DESIGN */
    .btn-login {
      width: 100%;
      background: var(--primary);
      color: white;
      border: none;
      padding: 12px;
      border-radius: 15px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-top: 5px;
      box-shadow: 0 4px 10px rgba(5, 150, 105, 0.25);
    }

    .btn-login:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 15px rgba(5, 150, 105, 0.35);
    }

    .btn-login:active {
      transform: translateY(0);
    }

    /* Toast */
    .toast-notification {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #1f2937;
      color: white;
      padding: 14px 20px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      z-index: 9999;
    }

    .toast-notification.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .toast-icon {
      color: #f87171;
      font-size: 1.1rem;
    }

    @media (max-width: 768px) {
      .auth-container {
        flex-direction: column;
      }

      .auth-image-side {
        padding: 40px 20px;
      }

      .auth-form-side {
        padding: 40px 30px;
      }
    }
  </style>
</head>

<body>

  <div class="auth-container">
    <!-- Left: Image & Logo -->
    <div class="auth-image-side">
      <div class="content-overlay">
        <h1
          style="font-size: 2.8rem; font-weight: 800; margin-bottom: 15px; letter-spacing: 1px; display: flex; align-items: center; justify-content: center; gap: 12px; text-shadow: 0 4px 15px rgba(0,0,0,0.4);">
          <span>Santosh <span style="color: #45bd71;">Park</span></span>
        </h1>
        <h2>Admin Portal</h2>
        <p>Manage operations with ease</p>
      </div>
    </div>

    <!-- Right: Login Form -->
    <div class="auth-form-side">
      <h3>Welcome Back</h3>
      <p class="subtitle">Enter your credentials to access the dashboard.</p>

      <form action="/superadmin_login" method="post" id="myForm">

        <div class="input-group-custom">
          <label for="user_id">Username</label>
          <input type="text" class="form-control" id="user_id" name="user_id" placeholder="e.g. admin123" required>
          <i class="bi bi-person input-icon"></i>
        </div>

        <div class="input-group-custom">
          <label for="password">Password</label>
          <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
          <i class="bi bi-lock input-icon"></i>
          <i class="bi bi-eye password-toggle" id="togglePassword"></i>
        </div>

        <button type="submit" class="btn-login" id="loginBtn">
          Login to Dashboard
        </button>
      </form>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast-notification" id="toast">
    <i class="bi bi-exclamation-circle-fill toast-icon"></i>
    <span id="toastMessage">Invalid credentials. Please try again.</span>
  </div>

  <script>
    const togglePassword = document.getElementById('togglePassword');
    const password = document.getElementById('password');

    togglePassword.addEventListener('click', function () {
      const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
      password.setAttribute('type', type);
      this.classList.toggle('bi-eye');
      this.classList.toggle('bi-eye-slash');
    });

    document.getElementById("myForm").addEventListener("submit", async function (event) {
      event.preventDefault();

      const btn = document.getElementById('loginBtn');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right: 8px;"></span> Authenticating...';
      btn.disabled = true;

      const userId = document.getElementById("user_id").value;
      const pass = document.getElementById("password").value;

      try {
        const formData = new URLSearchParams();
        formData.append("user_id", userId);
        formData.append("password", pass);

        const response = await fetch("/superadmin_login", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: formData,
          redirect: "follow"
        });

        if (response.redirected && response.url.includes("/superadmin/dashboard")) {
          window.location.href = response.url;
        } else {
          showToast("Incorrect username or password");
          btn.innerHTML = originalText;
          btn.disabled = false;
        }

      } catch (error) {
        showToast("Connection error. Please try again.");
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    });

    function showToast(message) {
      const toast = document.getElementById("toast");
      const toastMessage = document.getElementById("toastMessage");

      toastMessage.innerText = message;
      toast.classList.add("show");

      setTimeout(() => {
        toast.classList.remove("show");
      }, 4000);
    }
  </script>

</body>

</html>
<div class="container-fluid">
  <div class="col-sm-12 col-md-12 col-lg-12">
    <div class="card">
      <div class="card-body">
        <div class="titleSec">
          <button type="button" class="btn btn-primary px-3" id="myBtn"
            style="float: inline-end;border-radius: 6px;cursor: pointer;"><i class="fa fa-plus"></i> Add Header
            Footer</button>
        </div>
        <div class="row mt-4">
          <h3 class="text-dark"><i data-feather="activity" class="feather-icon text-dark"></i>&nbsp;<b>Header &
              Footer</b>
          </h3>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="table-responsive mt-3">
              <table id="dataTable" class="table table-striped table-bordered no-wrap show_data">
                <thead>
                  <tr>
                    <th class="text-center text-dark">Sl No.</th>
                    <th class="text-center text-dark">Location Name</th>
                    <th class="text-center text-dark">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(data.msg && data.msg.length> 0) { %>
                    <% data.msg.forEach(function(item,index) { %>
                      <% if (user.userData.user_type==='S' || (user.userData.user_type==='A' &&
                        item.customer_id==user.userData.customer_id)) { %>
                        <tr>
                          <td class="text-center text-dark">
                            <%=(index+1)%>
                          </td>
                          <td class="text-center text-dark">
                            <%=item.customer_name %>
                          </td>
                          <td class="text-center text-dark">
                            <a href="edit_header_footer?id=<%= item.receipt_setting_id %>&customer_id=<%= item.customer_id %>"
                              class="btn btn-success"
                              style="background-color: #127253; border-color: #127253; border-radius: 5px;"><i
                                class="fa fa-edit"></i></a>
                          </td>
                        </tr>
                        <% } %>
                          <% }); %>
                            <% } else { %>
                              <tr>
                                <td colspan="3" class="text-danger text-center">No data available</td>
                              </tr>
                              <% } %>

                </tbody>
                <tfoot>

                </tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer class="simple-footer mt-4">
    <b>Santosh Parking © <span id="footerYear"></b></span>
  </footer>
</div>


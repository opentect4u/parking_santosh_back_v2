  <script>
    updateCharCount('header_1', 'charCount1');
    updateCharCount('header_2', 'charCount2');
    updateCharCount('header_3', 'charCount3');
    updateCharCount('header_4', 'charCount4');
    updateCharCount('header_5', 'charCount9');
    updateCharCount('header_6', 'charCount10');
    updateCharCount('header_7', 'charCount11');
    updateCharCount('header_8', 'charCount12');
    updateCharCount('footer_1', 'charCount5');
    updateCharCount('footer_2', 'charCount6');
    updateCharCount('footer_3', 'charCount7');
    updateCharCount('footer_4', 'charCount8');
    updateCharCount('footer_5', 'charCount13');
    updateCharCount('footer_6', 'charCount14');
    updateCharCount('footer_7', 'charCount15');
    updateCharCount('footer_8', 'charCount16');
    function updateCharCount(textareaId, countId) {
      var textarea = document.getElementById(textareaId);
      var charCount = document.getElementById(countId);

      if (textarea && charCount) {
        var count = textarea.value.length;
        charCount.innerHTML = '<span style="font-weight: bold;">(' + count + '/25)</span>';
      }
    }

    $(document).ready(function () {
      // Store initial state
      setTimeout(function () {
        $('#myForm').find('input, textarea').each(function () {
          if ($(this).is(':checkbox')) {
            $(this).data('initial', $(this).prop('checked'));
          } else {
            $(this).data('initial', $(this).val());
          }
        });
      }, 200); // 200ms gives toggle plugin time to initialize fully

      function checkFormState() {
        setTimeout(function () {
          let isChanged = false;
          $('#myForm').find('input, textarea').each(function () {
            if ($(this).is(':checkbox')) {
              if ($(this).prop('checked') !== $(this).data('initial')) {
                isChanged = true;
              }
            } else {
              // Ignore hidden inputs like id/cust_id if their initial is undefined
              if (typeof $(this).data('initial') !== 'undefined' && $(this).val() !== $(this).data('initial')) {
                isChanged = true;
              }
            }
          });

          $('#updateBtn').prop('disabled', !isChanged);
        }, 50); // slight delay to allow UI to update
      }

      // Bind events to textareas and text inputs
      $('#myForm').on('input change keyup', 'input[type="text"], textarea', checkFormState);

      // Bind click events on the toggle wrapper directly
      $('body').on('click', '.toggle', function () {
        checkFormState();
      });

      // Fallback for native checkbox change
      $('input[type="checkbox"]').on('change', checkFormState);
    });
  </script>
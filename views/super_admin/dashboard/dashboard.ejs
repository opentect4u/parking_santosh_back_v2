    <script>
      const btn = document.getElementById("dropdownBtn");
      const menu = document.getElementById("dropdownMenu");
      const locationBox = document.getElementById("locationDetails");

      // Elements for counts
      const totalReceiptEl = document.getElementById("totalReceiptEl");
      const totalOperatorEl = document.getElementById("totalOperatorEl");
      const totalAmounttEl = document.getElementById("totalAmounttEl");
      const totalDeviceEl = document.getElementById("totalDeviceEl");

      // Toggle dropdown on button click
      btn.addEventListener("click", (e) => {
        e.stopPropagation(); // prevent click from bubbling to document
        menu.style.display = menu.style.display === "block" ? "none" : "block";
      });

      // Handle selection
      document.querySelectorAll(".dropdown-item").forEach(item => {
        item.addEventListener("click", () => {
          const selectedText = item.textContent.trim();
          const locationId = item.dataset.value;

          btn.textContent = selectedText;
          menu.style.display = "none";
          console.log(locationId, 'location');


          if (locationBox) {
            locationBox.textContent = "Details of " + selectedText.replace("📍", "").trim();
          }

          const today = new Date().toISOString().split("T")[0]; // e.g. "2025-09-16"

          try {
            fetch(`/superadmin/dashboard_page?location_id=${locationId}&date=${today}`)
              .then(res => res.json())
              .then(data => {
                console.log("API Response:", data);

                // ✅ Update dashboard cards
                document.getElementById("totalReceiptEl").innerText = data.receipts;
                document.getElementById("lifetimeReceiptEl").innerText = data.totalReceipts;
                document.getElementById("totalOperatorEl").innerText = data.operators;
                document.getElementById("totalDeviceEl").innerText = data.devices;
                document.getElementById("lifetimeAmountEl").innerText = "₹" + data.totalAmount;
                document.getElementById("totalAmounttEl").innerText = "₹" + data.todayAmount;

                renderCharts(data);
              })
              .catch(err => console.error("Error fetching dashboard data:", err));

          } catch (err) {
            console.error("Error fetching dashboard data", err);
          }
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener("click", (e) => {
        if (!btn.contains(e.target) && !menu.contains(e.target)) {
          menu.style.display = "none";
        }
      });
    </script>


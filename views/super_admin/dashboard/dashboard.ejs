  let dailyChartInstance = null;
  let monthlyChartInstance = null;
  let operatorChartInstance = null;
  let deviceChartInstance = null;
  let payModeChartInstance = null;
  let vehicleChartInstance = null;

  // Function to initialize empty charts
  function getEmptyConfig(titleText, chartType = "bar") {
    return {
      type: chartType,
      data: {
        labels: ["Select a location"],
        datasets: [{
          data: chartType === "doughnut" ? [1] : [0], // Give doughnut a slice to render the text
          backgroundColor: "rgba(229, 231, 235, 0.5)", // Light gray placeholder
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          title: {
            display: true,
            text: titleText,
            color: "#6b7280",
            font: { size: 16, weight: '600' },
            padding: { top: 20, bottom: 20 }
          },
          legend: { display: false },
          tooltip: { enabled: false }
        },
        scales: chartType === "bar" ? {
          x: { grid: { display: false }, ticks: { color: "#9ca3af", font: { style: 'italic' } } },
          y: { display: false }
        } : {}
      }
    };
  }

  function initEmptyCharts() {
    const dailyCtx = document.getElementById("dailyReceiptsChart").getContext("2d");
    dailyChartInstance = new Chart(dailyCtx, getEmptyConfig("Waiting for Location Data...", "bar"));

    const monthlyCtx = document.getElementById("monthlyReceiptsChart").getContext("2d");
    monthlyChartInstance = new Chart(monthlyCtx, getEmptyConfig("Waiting for Location Data...", "bar"));

    const operatorCtx = document.getElementById("operatorReceiptsChart").getContext("2d");
    operatorChartInstance = new Chart(operatorCtx, getEmptyConfig("Waiting for Location Data...", "bar"));

    const deviceCtx = document.getElementById("deviceReceiptsChart").getContext("2d");
    deviceChartInstance = new Chart(deviceCtx, getEmptyConfig("Waiting for Location Data...", "bar"));

    const payModeCtx = document.getElementById("payModeReceiptsChart").getContext("2d");
    payModeChartInstance = new Chart(payModeCtx, getEmptyConfig("Waiting for Location Data...", "doughnut"));

    const vehicleCtx = document.getElementById("vehicleReceiptsChart").getContext("2d");
    vehicleChartInstance = new Chart(vehicleCtx, getEmptyConfig("Waiting for Location Data...", "bar"));
  }

  // Call this on page load
  initEmptyCharts();

  function renderCharts(data) {
    const now = new Date();
    const currentMonth = now.getMonth(); // 0–11
    const currentYear = now.getFullYear();

    // ✅ FILTER DAILY DATA FOR CURRENT MONTH
    const filteredDailyReceipts = data.dailyReceipts.filter(d => {
      const dt = new Date(d.date);
      return (
        dt.getMonth() === currentMonth &&
        dt.getFullYear() === currentYear
      );
    });

    if (dailyChartInstance) dailyChartInstance.destroy();
    if (monthlyChartInstance) monthlyChartInstance.destroy();
    if (operatorChartInstance) operatorChartInstance.destroy();
    if (deviceChartInstance) deviceChartInstance.destroy();
    if (payModeChartInstance) payModeChartInstance.destroy();
    if (vehicleChartInstance) vehicleChartInstance.destroy();

    // ========== Dynamic Width Calculations ==========
    const dailyContainer = document.getElementById("dailyChartContainer");
    const minDailyWidth = filteredDailyReceipts.length * 50; // 50px per bar
    if (dailyContainer && dailyContainer.parentElement) {
      dailyContainer.style.width = Math.max(minDailyWidth, dailyContainer.parentElement.clientWidth) + 'px';
    }

    const monthlyContainer = document.getElementById("monthlyChartContainer");
    const minMonthlyWidth = data.monthlyReceipts.length * 60; // 60px per bar
    if (monthlyContainer && monthlyContainer.parentElement) {
      monthlyContainer.style.width = Math.max(minMonthlyWidth, monthlyContainer.parentElement.clientWidth) + 'px';
    }

    // ========== Daily Chart ==========
    const dailyCtx = document.getElementById("dailyReceiptsChart").getContext("2d");

    dailyChartInstance = new Chart(dailyCtx, {
      type: "bar",
      data: {
        labels: filteredDailyReceipts.map(d => {
          const dt = new Date(d.date);
          return dt.toLocaleDateString("en-US", { day: "numeric", month: "short" });
        }),
        datasets: [{
          label: "Amount Collected (₹)",
          data: filteredDailyReceipts.map(d => parseFloat(d.amount) || 0),
          backgroundColor: "rgba(59, 130, 246, 0.85)",
          borderRadius: 4,
          maxBarThickness: 50
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: {
            type: 'category',
            ticks: {
              autoSkip: true,
              maxRotation: 45,
              minRotation: 0,
              align: 'center'
            },
            grid: { display: false }
          },
          y: {
            beginAtZero: true,
            title: { display: true, text: "Amount (₹)" },
            ticks: {
              callback: (value) => "₹" + value.toLocaleString(),
              padding: 10
            }
          }
        },
        plugins: {
          tooltip: {
            callbacks: {
              label: (context) => {
                const idx = context.dataIndex;
                const amount = context.dataset.data[idx];
                const count = filteredDailyReceipts[idx].count;
                return [
                  `Amount: ₹${amount.toLocaleString()}`,
                  `Receipts: ${count}`
                ];
              }
            }
          }
        }
      }
    });

    // ========== Monthly Chart ==========
    const monthlyCtx = document.getElementById("monthlyReceiptsChart").getContext("2d");

    monthlyChartInstance = new Chart(monthlyCtx, {
      type: "bar",
      data: {
        labels: data.monthlyReceipts.map(d => {
          const dt = new Date(d.month + "-01");
          return dt.toLocaleString("en-US", { month: "short", year: "numeric" });
        }),
        datasets: [{
          label: "Amount Collected (₹)",
          data: data.monthlyReceipts.map(d => parseFloat(d.amount) || 0),
          backgroundColor: "rgba(16, 185, 129, 0.85)",
          borderRadius: 4,
          maxBarThickness: 50
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: {
            ticks: {
              autoSkip: true,
              maxRotation: 45
            },
            grid: { display: false }
          },
          y: {
            beginAtZero: true,
            title: { display: true, text: "Amount (₹)" },
            ticks: {
              callback: (value) => "₹" + value.toLocaleString(),
              padding: 10
            }
          }
        },
        plugins: {
          tooltip: {
            callbacks: {
              label: (context) => {
                const idx = context.dataIndex;
                const amount = context.dataset.data[idx];
                const count = data.monthlyReceipts[idx].count;
                return [
                  `Amount: ₹${amount.toLocaleString()}`,
                  `Receipts: ${count}`
                ];
              }
            }
          }
        }
      }
    });

    // ========== Dynamic Width Calculations for Operator and Device ==========
    const operatorContainer = document.getElementById("operatorChartContainer");
    const minOperatorWidth = (data.operatorEntries || []).length * 60;
    if (operatorContainer && operatorContainer.parentElement) {
      operatorContainer.style.width = Math.max(minOperatorWidth, operatorContainer.parentElement.clientWidth) + 'px';
    }

    const deviceContainer = document.getElementById("deviceChartContainer");
    const minDeviceWidth = (data.deviceEntries || []).length * 60;
    if (deviceContainer && deviceContainer.parentElement) {
      deviceContainer.style.width = Math.max(minDeviceWidth, deviceContainer.parentElement.clientWidth) + 'px';
    }

    // ========== Operator Chart ==========
    const operatorCtx = document.getElementById("operatorReceiptsChart").getContext("2d");
    operatorChartInstance = new Chart(operatorCtx, {
      type: "bar",
      data: {
        labels: (data.operatorEntries || []).map(d => d.operator || "Unknown"),
        datasets: [{
          label: "Entries Count",
          data: (data.operatorEntries || []).map(d => d.count),
          backgroundColor: "rgba(245, 158, 11, 0.85)",
          borderRadius: 4,
          maxBarThickness: 50
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { ticks: { autoSkip: true, maxRotation: 45 }, grid: { display: false } },
          y: { beginAtZero: true, title: { display: true, text: "Entries" } }
        }
      }
    });

    // ========== Device Chart ==========
    const deviceCtx = document.getElementById("deviceReceiptsChart").getContext("2d");
    deviceChartInstance = new Chart(deviceCtx, {
      type: "bar",
      data: {
        labels: (data.deviceEntries || []).map(d => d.device || "Unknown"),
        datasets: [{
          label: "Entries Count",
          data: (data.deviceEntries || []).map(d => d.count),
          backgroundColor: "rgba(236, 72, 153, 0.85)",
          borderRadius: 4,
          maxBarThickness: 50
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { ticks: { autoSkip: true, maxRotation: 45 }, grid: { display: false } },
          y: { beginAtZero: true, title: { display: true, text: "Entries" } }
        }
      }
    });

    // ========== Payment Mode Chart ==========
    const payModeCtx = document.getElementById("payModeReceiptsChart").getContext("2d");
    payModeChartInstance = new Chart(payModeCtx, {
      type: "doughnut",
      data: {
        labels: (data.payModeEntries || []).map(d => {
          if (d.pay_mode === 'C' || d.pay_mode === 'Cash') return 'Cash';
          if (d.pay_mode === 'U' || d.pay_mode === 'UPI') return 'UPI';
          return d.pay_mode || 'Unknown';
        }),
        datasets: [{
          data: (data.payModeEntries || []).map(d => parseFloat(d.total_amount) || 0),
          backgroundColor: [
            "rgba(16, 185, 129, 0.85)", // Emerald Green for Cash
            "rgba(99, 102, 241, 0.85)", // Indigo for UPI
            "rgba(245, 158, 11, 0.85)", // Amber
            "rgba(236, 72, 153, 0.85)"  // Pink
          ],
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'right',
            labels: {
              color: '#000',
              font: { size: 13, weight: 'bold' }
            }
          },
          tooltip: {
            callbacks: {
              label: (context) => {
                const amount = context.dataset.data[context.dataIndex];
                return `Amount: ₹${amount.toLocaleString()}`;
              }
            }
          }
        }
      }
    });

    // ========== Vehicle Types Chart ==========
    const vehicleCtx = document.getElementById("vehicleReceiptsChart").getContext("2d");
    vehicleChartInstance = new Chart(vehicleCtx, {
      type: "bar",
      data: {
        labels: (data.vehicleTypeEntries || []).map(d => d.vehicle || "Unknown"),
        datasets: [{
          label: "Vehicles Parked",
          data: (data.vehicleTypeEntries || []).map(d => d.count),
          backgroundColor: "rgba(99, 102, 241, 0.85)",
          borderRadius: 4,
          maxBarThickness: 50
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { ticks: { autoSkip: true, maxRotation: 45 }, grid: { display: false } },
          y: {
            beginAtZero: true, 
            title: { display: true, text: "Count" }
          }
        }
      }
    });
  }

  const today = new Date().toISOString().split("T")[0]; // e.g. "2025-09-16"

  // Example fetch for admin or superadmin
  const locationId = "<%= user.userData.customer_id || '' %>"; // admin location

  // Auto-load only for Admin
  fetch(`/superadmin/dashboard_page?location_id=${locationId}&date=${today}`)
    .then(res => res.json())
    .then(data => {
      document.getElementById("totalReceiptEl").innerText = data.receipts;
      document.getElementById("lifetimeReceiptEl").innerText = data.totalReceipts;
      document.getElementById("totalOperatorEl").innerText = data.operators;
      document.getElementById("totalDeviceEl").innerText = data.devices;
      document.getElementById("lifetimeAmountEl").innerText = "₹" + data.totalAmount;
      document.getElementById("totalAmounttEl").innerText = "₹" + data.todayAmount;

      // Render charts
      renderCharts(data);
    });

</script>

<script>


  function updateGreeting() {
    const now = new Date();
    const hours = now.getHours();
    let greeting = "Hello";

    if (hours >= 5 && hours < 12) {
      greeting = "Good Morning";
    } else if (hours >= 12 && hours < 18) {
      greeting = "Good Afternoon";
    } else if (hours >= 18 && hours < 22) {
      greeting = "Good Evening";
    } else {
      greeting = "Good Night";
    }

    // Show greeting with name
    document.getElementById("greeting").textContent = `${greeting}, ${user.userData.customer_name || "User"} 👋`;

    // Format date as: Aug 30, 2025
    const options = { year: 'numeric', month: 'short', day: 'numeric' };
    const formattedDate = now.toLocaleDateString('en-US', options);
    document.getElementById("currentDate").textContent = formattedDate;
  }

  // Call once on load
  updateGreeting();

  // Update every minute
  setInterval(updateGreeting, 60000);
</script>
  <style>
    /* Dashboard Banner */
    .custom-banner {
      background: #25894d;
      /* dark emerald */
      border-radius: 16px;
      padding: 30px;
      color: #fff;
      margin-bottom: 40px;
    }

    .custom-banner .badge-pill {
      background: rgba(255, 255, 255, 0.2);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 16px;
    }

    .custom-banner h1 {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 12px;
      color: #fff;
    }

    .custom-banner p {
      font-size: 15px;
      color: #d1fae5;
      margin: 0;
      max-width: 600px;
      line-height: 1.5;
    }

    /* Stat Cards */
    .stat-card {
      background: #fff;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      display: flex;
      align-items: center;
      gap: 20px;
      border: 1px solid #f3f4f6;
      height: 100%;
    }

    .stat-card .icon-circle {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .icon-circle.green {
      background: #d1fae5;
      color: #10b981;
    }

    .icon-circle.teal {
      background: #ccfbf1;
      color: #14b8a6;
    }

    .icon-circle.purple {
      background: #e0e7ff;
      color: #6366f1;
    }

    .icon-circle.red {
      background: #fee2e2;
      color: #ef4444;
    }

    .stat-card .stat-info h2 {
      font-size: 24px;
      font-weight: 700;
      color: #1f2937;
      margin: 0 0 4px 0;
    }

    .stat-card .stat-info p {
      font-size: 13px;
      color: #6b7280;
      margin: 0;
      font-weight: 500;
    }

    /* Premium Location Dropdown */
    .custom-location-btn {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      backdrop-filter: blur(10px);
      border-radius: 10px;
      padding: 10px 20px;
      font-weight: 600;
      font-size: 15px;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .custom-location-btn:hover,
    .custom-location-btn:focus {
      background: rgba(255, 255, 255, 0.25);
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.4);
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
    }

    .custom-location-btn::after {
      content: '▼';
      font-size: 10px;
      margin-left: 8px;
      opacity: 0.8;
    }

    .custom-location-menu {
      background: #ffffff;
      border: none;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      padding: 8px;
      min-width: 240px;
      margin-top: 10px !important;
    }

    .custom-location-menu .dropdown-item {
      border-radius: 8px;
      padding: 10px 16px;
      font-weight: 500;
      color: #374151;
      transition: all 0.2s;
      cursor: pointer;
    }

    .custom-location-menu .dropdown-item:hover {
      background: #f3f4f6;
      color: #10b981;
    }
  </style>

  <div class="custom-banner d-flex justify-content-between align-items-start">
    <div>
      <span class="badge-pill">Project Analytics</span>
      <% if (user.userData.user_type==='S' ) { %>
        <h1>Select Your Location</h1>
        <% } else if (user.userData.user_type==='A' ) { %>
          <h1>
            <%= user.userData.customer_name %>
          </h1>
          <% } %>
            <p>Read operations, revenue, operator performance, device activity, payment mix, and recent activity from
              one clean screen.</p>
    </div>

    <div class="d-flex flex-column align-items-end gap-3">
      <div class="text-light fw-bold d-flex gap-3 align-items-center" style="font-weight: 500;">
        <span>🗓️ <span id="currentDate"></span></span>&nbsp; | &nbsp;
        <span>⏰ <span id="currentTime"></span></span>
      </div>

      <% if (user.userData.user_type==='S' ) { %>
        <div class="dropdown mt-5">
          <button class="custom-location-btn" id="dropdownBtn">🌍 Choose location...</button>
          <div class="dropdown-menu custom-location-menu" id="dropdownMenu">
            <div class="dropdown-item" data-value="0">📍 Choose Location</div>
            <% if (data && data.msg && data.msg.length> 0) { %>
              <% data.msg.forEach(dt=> { %>
                <div class="dropdown-item" data-value="<%= dt.location_id %>">
                  📍 <%= dt.loction %>
                </div>
                <% }) %>
                  <% } else { %>
                    <div class="dropdown-item disabled">No locations available</div>
                    <% } %>
          </div>
        </div>
        <% } %>
    </div>
  </div>

  <div class="card shadow-none bg-transparent border-0 p-0">

    <div class="d-none">
      <span id="locationDetails" class="location-box">Details of ...</span>
      <h3 id="greeting" class="page-title text-gradient fw-bold mb-1"></h3>
    </div>

    <script>
      function updateDateTime() {
        const now = new Date();

        const dateOptions = { year: 'numeric', month: 'short', day: 'numeric' };
        document.getElementById("currentDate").textContent = now.toLocaleDateString('en-US', dateOptions);

        const timeOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit' };
        document.getElementById("currentTime").textContent = now.toLocaleTimeString('en-IN', timeOptions);
      }

      updateDateTime();
      setInterval(updateDateTime, 1000);
    </script>





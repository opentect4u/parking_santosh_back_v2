<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<div class="container-fluid py-4" style="background: #f5f7fa;">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <!-- Card -->
      <div class="card rounded-4 border-0 full-rounded-card">

        <!-- Card Header -->
        <div class="card-header bg-white py-3 d-flex align-items-center">
          <div id="back" class="back-btn-custom me-4" title="Go Back" style="margin-right: 24px !important;">
            <i class="fas fa-chevron-left"></i>
          </div>
          <h5 class="mb-0 fw-bold d-flex align-items-center" style="color: #1f2937;">
            <i class="fas fa-rupee-sign me-3" style="color: #127253;"></i>&nbsp; Edit Vehicle Rate Details
          </h5>
        </div>
        <div class="card-body p-3">
          <form action="/superadmin/vehicle_rate_save" id="myForm" method="post">
            <div class="row g-2">

              <!-- Customer Name -->
<div class="col-md-4">
  <label for="cust_name" class="form-label"><b>Location Name:</b></label>
  <div class="position-relative">
    <% let selectedCust = customer.find(c => c.customer_id == data[0].customer_id); %>
    <input type="text" class="form-control shadow-sm rounded-3 py-2 px-3" id="cust_name" value="<%= selectedCust ? selectedCust.customer_name : '' %>" readonly>
  </div>
</div>

<!-- Rate Type -->
<!-- <div class="col-md-4">
  <label for="rate_name" class="form-label"><b>Rate Type:</b></label>
  <div class="position-relative">
    <select name="rate_name" class="form-select shadow-sm rounded-pill custom-select" id="rate_name" disabled>
      <option value="">Select Rate Type</option>
      <option value="H" <% if (data[0].rate_type === 'H') { %>selected<% } %>>Hourly</option>
      <option value="F" <% if (data[0].rate_type === 'F') { %>selected<% } %>>Fixed</option>
    </select>
  </div>
</div> -->

<!-- Vehicle Name -->
<div class="col-md-4">
  <label for="veh_id" class="form-label"><b>Vehicle Name:</b></label>
  <div class="position-relative">
    <% let selectedVeh = vehicle.find(v => v.vehicle_id == data[0].vehicle_id); %>
    <input type="text" class="form-control shadow-sm rounded-3 py-2 px-3" id="veh_id" value="<%= selectedVeh ? selectedVeh.vehicle_name : '' %>" readonly>
  </div>
</div>

<!-- Select Flag -->
<div class="col-md-4">
  <label for="night_day_flag" class="form-label"><b>Rate Flag:</b></label>
  <div class="position-relative">
    <select name="night_day_flag" class="form-control" id="night_day_flag" required>
      <option value="">Select Rate Flag</option>
      <option value="O" <%= data[0].night_day_flag === 'O' ? 'selected' : '' %>>Old Rate</option>
      <option value="N" <%= data[0].night_day_flag === 'N' ? 'selected' : '' %>>New Rate</option>
      <option value="C" <%= data[0].night_day_flag === 'C' ? 'selected' : '' %>>Custom</option>
    </select>
  </div>
</div>


              <!-- From Hour -->
              <div class="col-md-4 mt-4">
                <label for="frm_hr" class="form-label"><b>From Hour:</b></label>
                <input type="number" min="0" class="form-control shadow-sm rounded-3 py-2 px-3" id="frm_hr" name="frm_hr" value="<%= data[0].from_hour %>">
              </div>

              <!-- To Hour -->
              <div class="col-md-4 mt-4">
                <label for="to_hr" class="form-label"><b>To Hour:</b></label>
                <input type="number" min="0" class="form-control shadow-sm rounded-3 py-2 px-3" id="to_hr" name="to_hr" value="<%= data[0].to_hour %>">
              </div>

              <!-- Parking Fee -->
              <div class="col-md-4 mt-4">
                <label for="park_fee" class="form-label"><b>Parking Fee:</b></label>
                <input type="text" class="form-control shadow-sm rounded-3 py-2 px-3" id="park_fee" name="park_fee" value="<%= data[0].vehicle_rate %>">
              </div>
            </div>

            <!-- Hidden Fields -->
            <input type="hidden" name="id" value="<%= id %>">
            <input type="hidden" name="cust_id" value="<%= customer_id %>">

            <!-- Submit Button -->
            <div class="row mt-4 justify-content-center">
              <div class="form-group col-md-4 text-center">
                <input type="submit" value="UPDATE VEHICLE RATE" id="submitBtn"
                  class="btn btn-solid px-5 py-2 fw-bold text-uppercase" disabled />
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
<footer class="simple-footer mt-4">
  <b>Santosh Parking © <span id="footerYear"></b></span>
</footer>



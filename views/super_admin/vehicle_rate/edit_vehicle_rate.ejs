<script>
  $(document).ready(function () {
    $("#back").click(function () {
      window.location.href = "/superadmin/vehicle_rate";
    });

    // Keep the Vehicle Rate sidebar item activated
    const rateSidebarLink = $('ul#sidebarnav a[href="/superadmin/vehicle_rate"]');
    if (rateSidebarLink.length) {
      rateSidebarLink.addClass("active");
      rateSidebarLink.closest(".sidebar-item").addClass("selected");
    }

    // Dirty check logic to enable/disable submit button
    let initialParkFee = "";
    let initialFrmHr = "";
    let initialToHr = "";
    let initialRateFlag = "";
    setTimeout(function () {
      initialParkFee = $("#park_fee").val() || "";
      initialFrmHr = $("#frm_hr").val() || "";
      initialToHr = $("#to_hr").val() || "";
      initialRateFlag = $("#night_day_flag").val() || "";
    }, 300);

    function checkFormChanges() {
      const currentParkFee = $("#park_fee").val() || "";
      const currentFrmHr = $("#frm_hr").val() || "";
      const currentToHr = $("#to_hr").val() || "";
      const currentRateFlag = $("#night_day_flag").val() || "";

      if (currentParkFee !== initialParkFee || currentFrmHr !== initialFrmHr || currentToHr !== initialToHr || currentRateFlag !== initialRateFlag) {
        $("#submitBtn").removeAttr("disabled");
      } else {
        $("#submitBtn").attr("disabled", "disabled");
      }
    }

    $("#park_fee, #frm_hr, #to_hr, #night_day_flag").on("input keyup change paste", checkFormChanges);
  });
</script>

<script>
  document.getElementById("footerYear").textContent = new Date().getFullYear();
</script>
<script>
  window.addEventListener('load', function () {
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
    script.onload = function () {
      var dbRateFlag = '<%= data[0].night_day_flag %>'.trim();
      if(dbRateFlag !== 'O' && dbRateFlag !== 'N' && dbRateFlag !== 'C') {
        dbRateFlag = 'O'; // fallback if DB contains something like 'F'
      }
      $('#night_day_flag').val(dbRateFlag);
      $('#night_day_flag').select2({
        placeholder: "Select Rate Flag",
        allowClear: false,
        width: '100%'
      });
      
      // Bind the change event for Select2 to trigger dirty checking
      $('#night_day_flag').on('change', function() {
        if (typeof checkFormChanges === 'function') {
          checkFormChanges();
        }
      });
    };
    document.head.appendChild(script);
  });
</script>
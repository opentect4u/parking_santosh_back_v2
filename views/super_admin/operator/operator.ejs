<script>
  window.addEventListener('load', function () {
    // Dynamically load Select2 AFTER the main layout jQuery has fully loaded and overwritten window.$
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
    script.onload = function() {
      $('#cust_name').select2({
        placeholder: "Select Location Name",
        allowClear: true,
        width: '100%'
      });
      
      $('#cust_name_modal').select2({
        dropdownParent: $('#myModal'),
        placeholder: "Select Location Name",
        allowClear: true,
        width: '100%'
      });
    };
    document.body.appendChild(script);

    $('#mobile').on('change', function () {
      let mobile = $(this).val().trim();
      // let customer_id = $('#cust_name_modal').val() || $('#cust_name').val(); // 👈 check modal OR form dropdown
      let customer_id = "";

     <% if (user.userData.user_type === 'S') { %>
        // For SuperAdmin → from dropdown
        customer_id = $('#cust_name_modal').val();
      <% } else { %>
        // For Admin → from hidden input
        customer_id = "<%= user.userData.customer_id %>";
      <% } %>
    // console.log("Input changed:", mobile, "Customer ID:", customer_id);

    // Check only if mobile is 10 digits & customer is selected
    if (mobile.length === 10 && customer_id) {
        $.ajax({
          url: '/superadmin/check-mobile',
          type: 'POST',
          contentType: 'application/json',
          data: JSON.stringify({ mobile, customer_id }), // send both
          success: function (data) {
            console.log("API response:", data);
            let errorField = $('#mobileError');

            if (data.exists) {
              // ❌ Duplicate → show error + clear field
              errorField.text("* Phone number already exists for this location");
              $('#mobile').val('').focus();
            } else {
              // ✅ Not duplicate → clear error, keep value
              errorField.text("");
            }
          },
          error: function (xhr, status, error) {
            console.error("Error checking mobile:", error);
            $('#mobileError').text("* Server error while checking number");
          }
        });
      } else if (!customer_id) {
        $('#mobileError').text("* Please select a location first");
        $('#mobile').val('').focus();
      } else {
        $('#mobileError').text("* Enter a valid 10 digit number");
      }
    });
  });
</script>
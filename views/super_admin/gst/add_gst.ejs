<script>
  $(document).ready(function () {
    function calculateGST() {
      const category = $('#gst_category').val();
      const gstValue = $('#total_gst').val();

      if (category === 'I') {
        $('#cgst_div, #sgst_div').hide();
        $('#igst_div').show();
        if (gstValue !== "") {
          $('#igst_display').val(gstValue + '%');
          $('#igst').val(gstValue);
        } else {
          $('#igst_display, #igst').val('');
        }
        $('#cgst_display, #sgst_display').val('');
        $('#cgst, #sgst').val('0');
      } else if (category === 'CS') {
        $('#cgst_div, #sgst_div').show();
        $('#igst_div').hide();
        if (gstValue !== "") {
          const gst = gstValue / 2;
          $('#cgst_display').val(gst + '%');
          $('#sgst_display').val(gst + '%');
          $('#cgst').val(gst);
          $('#sgst').val(gst);
        } else {
          $('#cgst_display, #sgst_display, #cgst, #sgst').val('');
        }
        $('#igst_display').val('');
        $('#igst').val('0');
      } else {
        // No category selected
        $('#cgst_div, #sgst_div, #igst_div').hide();
        $('#cgst_display, #sgst_display, #igst_display, #cgst, #sgst, #igst').val('');
      }
    }

    $('#gst_category, #total_gst').on('change', calculateGST);

    // Initial calculation on load to set up display correctly
    calculateGST();
  });
</script>


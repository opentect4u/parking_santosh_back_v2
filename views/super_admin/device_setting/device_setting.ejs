<script>
  $(document).ready(function () {
    // On page load - check if grace_flag is checked
    toggleGraceValue();
    toggleAdvanceValue();


    // When grace_flag toggle changes
    $('#grace_flag').change(function () {
      toggleGraceValue();
    });

    // When advance_flag toggle changes
    $('#adv_pay_flag').change(function () {
      toggleAdvanceValue();
      if ($(this).prop('checked')) {
        if ($('#gst_flag').prop('checked')) {
          $('#gst_flag').bootstrapToggle('off');
        }
        $('#gst_flag').bootstrapToggle('disable');
      } else {
        $('#gst_flag').bootstrapToggle('enable');
      }
    });

    // When gst_flag toggle changes
    $('#gst_flag').change(function () {
      if ($(this).prop('checked')) {
        if ($('#adv_pay_flag').prop('checked')) {
          $('#adv_pay_flag').bootstrapToggle('off');
        }
        $('#adv_pay_flag').bootstrapToggle('disable');
      } else {
        $('#adv_pay_flag').bootstrapToggle('enable');
      }
    });

    // Initial check for exclusivity on load
    if ($('#adv_pay_flag').prop('checked')) {
      $('#gst_flag').bootstrapToggle('disable');
    } else if ($('#gst_flag').prop('checked')) {
      $('#adv_pay_flag').bootstrapToggle('disable');
    }

    function toggleGraceValue() {
      if ($('#grace_flag').prop('checked')) {
        $('.hide_grace').show();
      } else {
        $('.hide_grace').hide();
      }
    }

    function toggleAdvanceValue() {
      if ($('#adv_pay_flag').prop('checked')) {
        $('#hide_adv').show();
      } else {
        $('#hide_adv').hide();
      }
    }

    $("#myBtn").click(function () {
      $("#myModal").modal();
    });
  });
</script>

<script>
  $('#grace_flag').on('change', function () {
    if ($(this).is(':checked')) {
      $('#hide_grace').show()
      $('#grace_value').attr('required', 'required')
    } else {
      $('#grace_value').removeAttr('required')
      $('#grace_value').val('00')
      $('#hide_grace').hide()
    }
  })
</script>

<script>
  $('#adv_pay_flag').on('change', function () {
    if ($(this).is(':checked')) {
      $('#hide_adv').show()
      $('#adv_value').attr('required', 'required')
    } else {
      $('#adv_value').removeAttr('required')
      $('#adv_value').val('00')
      $('#hide_adv').hide()
    }
  })
</script>


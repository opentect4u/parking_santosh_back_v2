<script>
  $(document).ready(function () {
    var user_type = "<%= user.userData.user_type %>";
    var sel_dev_id = "<%= selected.dev_name != '' ? selected.dev_name : 0 %>";

    if (user_type === "A") {
      // Admin: get fixed customer_id from user data
      var cust_name = "<%= user.userData.customer_id %>";
      $('#cust_name').val(cust_name).prop('disabled', true); // fix dropdown
      change_cust(cust_name); // auto-load devices
    } else if (user_type === "S") {
      // Superadmin: work as before
      var flag = <%= selected.dev_name != '' ? true : false %>;
      if (flag) {
        var cust_name = "<%= selected.cust_id != '' ? selected.cust_id : '' %>";
        change_cust(cust_name);
      }
    }

    // Only allow change for superadmin
    $('#cust_name').on('change', function () {
      if (user_type === "S") {
        var cust_name = $(this).val();
        change_cust(cust_name);
      }
    });

    function change_cust(cust_name) {
      $.ajax({
        type: "POST",
        url: "/superadmin/device_dt",
        data: { cust_name: cust_name },
        success: function (response) {
          $('#dev_id_sel').empty().append(`<option value="">Select Device ID</option>`);
          response.SUCCESS.dev_id.msg.forEach(function (resData) {
            var _selected = sel_dev_id == resData.app_id;
            $('#dev_id_sel').append(
              $('<option>', { value: resData.app_id, text: resData.app_id, selected: _selected })
            );
          });
        },
        error: function (error) {
          console.log(error);
        },
      });
    }
  });
</script>



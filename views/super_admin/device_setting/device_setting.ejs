<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card shadow-lg rounded-4 border-0 p-3" style="border-radius: 20px;">
        <!-- <div class="titleSec">
          <button type="button" class="btn btn-primary" id="myBtn"
            style="float: inline-end;border-radius: 6px;width: 6vw;cursor: pointer;">Add</button>
        </div> -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="card-title mb-0 text-gradient fw-bold">
            <i data-feather="slack" class="feather-icon text-dark"></i>&nbsp;<b>Device Setting</b>
          </h3>
          <button type="button" class="btn btn-gradient" id="myBtn">
            <i class="fa fa-plus"></i> Add Device
          </button>
        </div>

        <form action="/superadmin/device_setting" method="post">
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label for="cust_name"><b style="color: black;">Location Name:</b></label>
              <select name="cust_name" class="form-control custom-dropdown" id="cust_name" required>
                <option value="">Select Location Name</option>
                <% customer.forEach(dt=> {
                  var _selected = ''
                  if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                  <option value="<%= dt.customer_id %>" <%=_selected %>><%= dt.customer_name %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <!-- If Admin: send hidden customer_id to backend -->
            <% if (user.userData.user_type==='A' ) { %>
              <input type="hidden" name="cust_name" value="<%= user.userData.customer_id %>">
              <% } %>

                <div class="col-md-4">
                  <label for="dev_id_sel"><b style="color: black;">Device ID:</b></label>
                  <select name="dev_id" class="form-control custom-dropdown" id="dev_id_sel" required>
                    <option value="">Select Device ID</option>
                  </select>
                </div>
                <div class="col-md-4 text-center">
                  <div class="d-flex justify-content-center mt-3">
                    <button type="submit" class="btn btn-gradient flex-grow-1" id="submitBtn" style="height: 45px;">
                      <i class="fa fa-search me-2"></i> Fetch Details
                    </button>
                    <a href="/superadmin/device_setting" class="btn shadow-sm"
                      style="height: 45px; width: 45px; margin-left: 16px; border-radius: 6px; display: flex; align-items: center; justify-content: center; background-color: #ffffff; color: #065f46; border: 1px solid #065f46; text-decoration: none; flex-shrink: 0;"
                      title="Refresh">
                      <i class="fas fa-sync-alt"></i>
                    </a>
                  </div>
                </div>
          </div>
        </form>


        <% if(selected.cust_id> 0){ %>
          <!-- <div class="row"> -->
          <!-- <div class="col-md-12"> -->
          <div class="table-responsive mt-4">
            <table id="dataTable" class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
              <thead class="custom-header text-center">
                <tr>
                  <th class="text-center text-dark">Sl No.</th>
                  <th class="text-center text-dark">App ID</th>
                  <th class="text-center text-dark">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if(data.length> 0){
                  var i = 1
                  data.forEach(dt => { %>
                  <tr>
                    <td class="text-center text-dark">
                      <%= i %>
                    </td>
                    <td class="text-center text-dark">
                      <%= dt.app_id %>
                    <td class="text-center text-dark"><a
                        href='/superadmin/edit_device_setting?customer_id=<%= selected.cust_id %>&id=<%= dt.setting_id %>'
                        class='btn btn-success'
                        style='background-color: #127253; border-color: #127253; border-radius: 5px;'><i
                          class='fa fa-edit'></i></a></td>
                  </tr>
                  <% i++; }) }else{ %>
                    <tr>
                      <td class="text-center text-danger" colspan="3">No data found</td>
                    </tr>
                    <% } %>
              </tbody>
              <tfoot></tfoot>
            </table>
          </div>
          <!-- </div> -->
          <!-- </div> -->
          <% } %>
      </div>
    </div>
  </div>
</div>
<footer class="simple-footer mt-4">
  <b>Santosh Parking © <span id="footerYear"></b></span>
</footer>


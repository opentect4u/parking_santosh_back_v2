<script>
  document.getElementById("footerYear").textContent = new Date().getFullYear();
</script>

<script>
  $(document).ready(function () {
    $('#cust_name_sel').change()
    $("#myBtn").click(function () {
      $("#myModal").modal();
      // $("#myBtn").hide()
    });
  });

  window.addEventListener('load', function () {
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
    script.onload = function () {
      $('#cust_name_sel').select2({
        placeholder: "Select Location Name",
        allowClear: true,
        width: '100%'
      });
      $('#veh_id_sel').select2({
        placeholder: "Select Vehicle Name",
        allowClear: true,
        width: '100%'
      });
      $('#cust_name').select2({
        dropdownParent: $('#myModal'),
        placeholder: "Select Location Name",
        allowClear: true,
        width: '100%'
      });
      $('#veh_id').select2({
        dropdownParent: $('#myModal'),
        placeholder: "Select Vehicle Name",
        allowClear: true,
        width: '100%'
      });
      $('#night_day_flag').select2({
        dropdownParent: $('#myModal'),
        placeholder: "Select Flag",
        allowClear: true,
        width: '100%'
      });
    };
    document.body.appendChild(script);
  });
</script>

<script>
  var cust_list = <%- JSON.stringify(customer) %>;
  var rate_type = [{ id: 'D', name: 'Hourly' }, { id: 'F', name: 'Fixed' }]
  $('#cust_name_sel').on('change', function () {
    // console.log('here lalalalal');
    var cust_id = $(this).val()
    changeProcess(cust_id)
  })

  $(document).ready(function () {
    // Superadmin: change event triggers on dropdown change
    $('#cust_name_sel').on('change', function () {
      var cust_id = $(this).val();
      changeProcess(cust_id);
    });

    // Admin: automatically fetch vehicles based on user.userData.customer_id
    <% if (user.userData.user_type === 'A') { %>
      var admin_cust_id = '<%= user.userData.customer_id %>';
      changeProcess(admin_cust_id);
    <% } else { %>
      // Superadmin: trigger change if already selected
      var sel_cust_id = '<%= selected.cust_id %>';
      if (sel_cust_id > 0) changeProcess(sel_cust_id);
    <% } %>

      // Modal button
      $("#myBtn").click(function () {
        $("#myModal").modal();
      });
  });

  // $(document).ready(function () {
  //   var sel_cust_id = '<%= selected.cust_id %>'
  //   if (sel_cust_id > 0) {
  //     changeProcess(sel_cust_id)
  //   }
  // })

  function changeProcess(cust_id) {
    var cust_dtls = cust_list.filter(dt => dt.customer_id == cust_id);
    $('#rate_type_name').empty()
    if (cust_dtls.length > 0) {
      $('#rate_type_name').append($('<option>', { value: '', text: 'Select Rate Type' }))
      $.each(rate_type, function (i, dt) {
        var selected = false
        if (cust_dtls[0].dev_mod == dt.id) selected = true
        $('#rate_type_name').append($('<option>', { value: dt.id, text: dt.name, selected: selected }))
      })
      $('#rate_type').val(cust_dtls[0].dev_mod)
    } else {
      alert('Please select dev mode in customer first')
    }

    // $('#cust_name').change(function () {
    //   var cust_id = $(this).val()
    //   var veh_id = $(this).val()

    $.ajax({
      type: "POST",
      url: "/superadmin/vehicle_dt",
      data: { cust_id: cust_id },
      success: function (response) {
        // console.log(response.SUCCESS.branchData.msg)
        $('#veh_id_sel').empty();
        $('#veh_id_sel').append(`<option value="">Select Vehicle Name</option>`)

        var sel_veh_id = '<%= selected.veh_id > 0 ? selected.veh_id : 0 %>'

        response.SUCCESS.veh_id.msg.forEach(function (resData) {
          var _selected = false
          if (sel_veh_id == resData.vehicle_id) _selected = true
          $('#veh_id_sel').append($('<option>', { value: resData.vehicle_id, text: resData.vehicle_name, selected: _selected }))
          // $('#veh_id').append('<option value="' + resData.vehicle_id + '">' + resData.vehicle_id + '</option>');
        });

        if ($('#veh_id_sel').hasClass('select2-hidden-accessible')) {
          $('#veh_id_sel').trigger('change.select2');
        }
      },
      error: function (error) {
        console.log(error);
        //   tbody.empty();
      },
    });
  }
</script>

